 UiCanvasGuard _uiGuard;
 glFillScreen();
 drawHeader();
 gfxSetTextColor(colorFG, colorBG);
 gfxDrawAligned(tr("Secondary ESP Wi-Fi", "Wi-Fi ESP phụ"), 8, 21, DATUM_TL);
