 if (!wlGrid || wlGridN < need) { if (wlGrid) free(wlGrid); wlGrid = (float *)wlAlloc(need * sizeof(float)); wlGridN = wlGrid ? need : 0; }
 if (!wlGrid) return;
#define WL_GV(ch, gy, gx) wlGrid[((size_t)(ch) * gh + (gy)) * gw + (gx)]
 float sigC = 17.f;
 for (int gy = 0; gy < gh; gy++) {
