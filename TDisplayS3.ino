 for (int y = 0; y < 19; y++) for (int x = 0; x < 19; x++) {
 int a = pgm_read_byte(A + y * 19 + x); if (!a) continue;
 int v = pgm_read_byte(B + y * 19 + x);
 int kb = v >> 4, ki = v & 15, kf = 15 - kb - ki; if (kf < 0) { kf = 0; }
 int r = (fr * kf + ir * ki) / 15, g = (fg * kf + ig * ki) / 15, b = (fb * kf + ib * ki) / 15;
 if (a < 255) { r = (r * a + br * (255 - a)) / 255; g = (g * a + bg * (255 - a)) / 255; b = (b * a + bb * (255 - a)) / 255; }
 gfx->drawPixel(gx + x, gy + y, spRGB(r, g, b));
 }
}
#define CH_CELL 20
#define CH_BX 1
#define CH_BY 1
#define CH_BW 168
#define CH_GX 5
#define CH_GY 5
