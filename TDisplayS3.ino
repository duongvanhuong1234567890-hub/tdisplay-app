 seenKb = s.pressSeq;
 if (age > TOUCH_EVENT_MAX_AGE_MS) return false;
 if (s.down) touchToScreen(s.nx, s.ny, sx, sy); else touchToScreen(s.pnx, s.pny, sx, sy);
