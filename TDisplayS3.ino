static void nsBuild() {
 nsN = 0;
 switch (nsPage) {
  case NSP_MAIN:
   nsAdd(NSI_CARD); nsAdd(NSI_GAP); nsAdd(NSI_SEARCH); nsAdd(NSI_GAP);
   nsAdd(NSI_SLBR); nsAdd(NSI_SLVOL); nsAdd(NSI_GAP);
