#define EASE_SCALE 1000
static int easeOutCubic(int step, int steps) {
 long t = (long)step * EASE_SCALE / steps;
 long inv = EASE_SCALE - t;
 long cube = inv * inv / EASE_SCALE * inv / EASE_SCALE;
 return (int)(EASE_SCALE - cube);
}
