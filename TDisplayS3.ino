  int cx1 = (x + (int)w > YG_TW) ? (YG_TW - x) : (int)w;
  if (cx1 <= cx0) continue;
  memcpy(gThumbDecDst + (size_t)yy * YG_TW + x + cx0, bitmap + (size_t)r * w + cx0, (size_t)(cx1 - cx0) * sizeof(uint16_t));
