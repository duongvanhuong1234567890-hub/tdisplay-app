 float dd = wlTab(WL_I_D, (int)(sizeof(WL_I_D) / 8), ts);
 float aa = wlTab(WL_I_A, (int)(sizeof(WL_I_A) / 8), ts);
 float rr = wlTab(WL_I_R, (int)(sizeof(WL_I_R) / 8), ts);
