 float rho = (t < 3.6f) ? wlLerp(0.f, 45.f, wlSmooth(3.55f, 3.6f, t)) : wlTab(WL_I4_RHO, (int)(sizeof(WL_I4_RHO) / 8), t);
 float th = ((t < 3.6f) ? -125.f : wlTab(WL_I4_TH, (int)(sizeof(WL_I4_TH) / 8), t)) * WL_PI / 180.f;
