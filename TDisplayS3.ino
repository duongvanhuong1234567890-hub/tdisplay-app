 while (s.length() > 0) {
 s = s.substring(0, utf8LastCharStart(s));
 String candidate = s + "..";
 gfx->getTextBounds(candidate.c_str(), 0, 0, &x1, &y1, &w, &h);
 if ((int)w <= maxWidthPx) return candidate;
 }
 return "..";
}
String truncateToWidthTail(const String &text, int maxWidthPx) {
