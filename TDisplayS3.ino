static const char *sysInfoLabel(int i) {
 switch (i) {
 case 0: return tr("Battery", "Pin");
 case 1: return tr("Chip temperature", "Nhiệt độ chip");
 case 2: return tr("Free RAM", "RAM trống");
 case 3: return tr("Free PSRAM", "PSRAM trống");
