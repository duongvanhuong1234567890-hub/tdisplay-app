 String hp = (pe < 0) ? url.substring(8) : url.substring(8, pe);
 path = (pe < 0) ? String("/") : url.substring(pe);
 int c = hp.indexOf(':');
 if (c >= 0) { host = hp.substring(0, c); port = (uint16_t)hp.substring(c + 1).toInt(); }
 else { host = hp; port = 443; }
 return host.length() > 0 && port > 0;
}
