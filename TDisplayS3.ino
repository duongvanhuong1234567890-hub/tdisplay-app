float readRailVoltage() {
 const int BATT_ADC_SAMPLES = 32;
 uint32_t sum_mv = 0;
 for (int i = 0; i < BATT_ADC_SAMPLES; i++) {
 sum_mv += analogReadMilliVolts(BAT_ADC_PIN);
