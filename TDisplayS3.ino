 wlFillFrame(0, 0, 1);
 float S = wlIntroS, cx = wlW * 0.5f, cy = wlH * 0.5f;
 const float W = 243.f;
 if (t < 3.55f) {
 float d = wlTab(WL_I_D, (int)(sizeof(WL_I_D) / 8), t);
 if (t >= 2.9f) d = 0.f;
 float r = wlTab(WL_I_R, (int)(sizeof(WL_I_R) / 8), t);
 if (t < 0.4f) d = 0.f;
 float dtBlur = (t > 1.55f && t < 2.75f) ? 0.045f : 0.f;
 int ns = dtBlur > 0.f ? 5 : 1;
 for (int k = 0; k < ns; k++) {
