static inline uint16_t spRGB(int r, int g, int b) { return (uint16_t)(((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3)); }
static inline void spUnpack(uint16_t c, int &r, int &g, int &b) { r = (c >> 11) << 3; g = ((c >> 5) & 63) << 2; b = (c & 31) << 3; }
static void chSprite(int gx, int gy, int idx, uint16_t bgc) {
 const uint8_t *A = CHS_A + idx * 324, *T = CHS_T + idx * 324;
 int br, bg, bb; spUnpack(bgc, br, bg, bb);
 int fb = (idx >= 6) ? 255 : 232;
 for (int y = 0; y < 18; y++) for (int x = 0; x < 18; x++) {
 int a = pgm_read_byte(A + y * 18 + x); if (!a) continue;
 int t = pgm_read_byte(T + y * 18 + x);
 int r = 255 * (255 - t) / 255, g = r, b = fb * (255 - t) / 255;
 if (a < 255) { r = (r * a + br * (255 - a)) / 255; g = (g * a + bg * (255 - a)) / 255; b = (b * a + bb * (255 - a)) / 255; }
 gfx->drawPixel(gx + x, gy + y, spRGB(r, g, b));
 }
