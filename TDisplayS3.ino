 if (fabsf(target - from) < 1.0f) { gYgPos = target; ygDrawPos(); return; }
 const int steps = 7;
 for (int st = 1; st <= steps; st++) {
  float t = (float)st / steps;
  float e = 1.0f - (1.0f - t) * (1.0f - t) * (1.0f - t);
  gYgPos = from + (target - from) * e;
