 int b2 = gmAnswer.indexOf("\n\nBạn: ", 1);
 int b = (b1 < 0) ? b2 : ((b2 < 0) ? b1 : min(b1, b2));
 if (b < 0) break;
 gmAnswer = gmAnswer.substring(b + 2);
 }
}
