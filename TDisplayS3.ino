static bool camStoreCb(int16_t x, int16_t y, uint16_t w, uint16_t h, uint16_t *bm) {
 if (!camDecBuf) return false;
 for (int r = 0; r < h; r++) {
  int yy = y + r; if (yy < 0 || yy >= camDecH) break;
  int cw = w; if (x + cw > camDecW) cw = camDecW - x;
