 if (c.isVideo && !m.v.ok) { c.ok = true; m.v = c; c.szTab = c.stco = c.stsc = nullptr; } else if (c.isAudio && !m.a.ok) { c.ok = true; m.a = c; c.szTab = c.stco = c.stsc = nullptr; }
 mp4FreeTrack(m.cur); m.cur = Mp4Track();
 } else if (depth >= 1) {
