 const bool chg = isUsbPowered();
 int batKey = pct * 2 + (chg ? 1 : 0);
 gClkBatCh = full || batKey != gClkBatKey;
 gClkBatKey = batKey;
 gClkBatCh = false;
 int dayKey = ok ? (t.tm_year * 400 + t.tm_yday) : -2;
