 int maxVisible = (gfx->height() - startY - GESTURE_BAR_ZONE_H) / rowH;
 extFixScroll(extRowCount(), maxVisible);
 int total = extRowCount();
 for (int row = 0; row < maxVisible && (extWifiTop + row) < total; row++)
