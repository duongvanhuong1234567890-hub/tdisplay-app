 if (!wlScanOpen[s]) wlDrawLock(lockCx, cy, fg, bg);
 wlDrawFan(fanCx, cy + 5, wlScanRssi[s] >= -60 ? 3 : (wlScanRssi[s] >= -72 ? 2 : 1), fg, COLOR_GRAY, bg);
