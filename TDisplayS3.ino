static int ntTextCap() {
  int cap = ntUseLfs ? NOTES_TEXT_MAX : NT_NVS_CAP;
  if (ntSearchMode) cap = NT_SEARCH_MAX;
  if (ntBufCap > 0 && cap > ntBufCap - 1) cap = ntBufCap - 1;
