void updateVideoSelection() {
 if (lastDrawnVideoIndex < 0) { drawVideoMenu(); return; }
 int rowH = VID_ROW_H;
 int startY = 22;
 int maxVisible = (gfx->height() - startY - GESTURE_BAR_ZONE_H) / rowH;
 if (videoIndex < videoTop) videoTop = videoIndex;
 if (videoIndex >= videoTop + maxVisible) videoTop = videoIndex - maxVisible + 1;
 if (videoTop < 0) videoTop = 0;
 if (videoTop > fileCount - maxVisible) videoTop = max(0, fileCount - maxVisible);
 if (videoTop != lastDrawnVideoTop) { drawVideoRowsOnly(rowH, startY, maxVisible); return; }
 CanvasRectPush _rp(0, startY, gfx->width(), maxVisible * rowH);
 gfx->startWrite();
 int oldRow = lastDrawnVideoIndex - videoTop;
 if (oldRow >= 0 && oldRow < maxVisible) drawVideoRow(lastDrawnVideoIndex, oldRow, startY, rowH);
 int newRow = videoIndex - videoTop;
 if (newRow >= 0 && newRow < maxVisible) drawVideoRow(videoIndex, newRow, startY, rowH);
 gfx->endWrite();
 lastDrawnVideoIndex = videoIndex;
 lastDrawnVideoTop = videoTop;
}
