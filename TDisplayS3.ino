#define CH_PW 144
#define CH_MAXH 700
static int chMode = 1, chSel = -1, chRes = 0;
static bool chTgt[64], chChk = false, chPend = false;
static unsigned long chAiAt = 0;
static ChUn chHist[CH_MAXH];
static int chHn = 0;
static void chRefresh() {
 ChMv l[256]; int n = chLegal(l);
 chChk = chInCheck(chSide); chRes = 0;
 if (!n) chRes = chChk ? (chSide > 0 ? 2 : 1) : 3;
 else if (chHalf >= 100 || chInsufficient() || chHn >= CH_MAXH) chRes = 3;
 chSel = -1; memset(chTgt, 0, sizeof(chTgt));
 chPend = (chRes == 0 && chMode < 3 && chSide < 0);
 chAiAt = millis() + 200;
}
static void chReset() { chSetup(); chHn = 0; chRefresh(); chPend = false; }
static void chPlay(const ChMv &m) { if (chHn < CH_MAXH) chMake(m, chHist[chHn++]); }
static inline int chCx(int sq) { return CH_GX + (7 - (sq >> 3)) * CH_CELL; }
static inline int chCy(int sq) { return CH_GY + (sq & 7) * CH_CELL; }
static void chTiny(int cgx, int cgy, int vx, int vy, int glyph, uint16_t col) {
 uint16_t g = CH_TINY[glyph];
 for (int py = 0; py < 5; py++) for (int px = 0; px < 3; px++)
 if (g & (1 << (14 - (py * 3 + px)))) gfx->drawPixel(cgx + CH_CELL - 1 - (vy + py), cgy + vx + px, col);
}
static void chDraw() {
 UiCanvasGuard _g;
 gfx->fillScreen(MG_BG);
 const uint16_t LIGHT = MGC(255, 253, 254), DARKC = MGC(220, 211, 201);
 gfx->fillRect(CH_BX, CH_BY, CH_BW, CH_BW, MGC(50, 32, 20));
 int lf = chHn ? chHist[chHn - 1].f : -1, lt = chHn ? chHist[chHn - 1].t : -1;
 int ks = chChk ? chKingSq(chSide) : -1;
 uint16_t cc[64];
 for (int sq = 0; sq < 64; sq++) {
 int r = sq >> 3, c = sq & 7;
 bool dark = (r + c) & 1;
 uint16_t col = dark ? DARKC : LIGHT;
 if (sq == lf || sq == lt) col = dark ? MGC(214, 196, 70) : MGC(246, 240, 140);
 if (sq == ks) col = MGC(230, 60, 60);
 if (sq == chSel) col = MGC(90, 200, 255);
 cc[sq] = col;
 gfx->fillRect(chCx(sq), chCy(sq), CH_CELL, CH_CELL, col);
 }
 for (int sq = 0; sq < 64; sq++) {
 int r = sq >> 3, c = sq & 7;
 bool dark = (r + c) & 1;
 uint16_t lab = dark ? LIGHT : DARKC;
 if (c == 0) chTiny(chCx(sq), chCy(sq), 1, 1, 7 - r, lab);
 if (r == 7) chTiny(chCx(sq), chCy(sq), CH_CELL - 4, CH_CELL - 6, 8 + c, lab);
 }
 for (int sq = 0; sq < 64; sq++) {
 int r = sq >> 3, c = sq & 7, x = chCx(sq), y = chCy(sq);
 if (chB[sq]) chSprite(x + 1, y + 1, (chB[sq] > 0 ? 0 : 6) + chAbs(chB[sq]) - 1, cc[sq]);
