 if (gExtJobBusy) { showMessage(tr("Busy, try again", "Đang bận, thử lại sau")); return; }
 strncpy(gExtPendSsid, ssid, 32); gExtPendSsid[32] = 0;
 strncpy(gExtPendPass, pass, 63); gExtPendPass[63] = 0;
 gExtConnResult = 0;
 gExtWifiSt = 1;
 if (!startExtJob(EXT_JOB_CONNECT)) {
