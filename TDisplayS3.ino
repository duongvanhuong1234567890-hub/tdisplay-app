void extOpenWifiPage() {
 appState = STATE_EXT_WIFI;
 listTouch.active = false;
 extWifiIndex = 1; extWifiTop = 0; lastDrawnExtTop = -1;
 gExtNetN = 0; gExtNetScan = 0; gExtConnResult = 0;
 extWifiWantScan = true;
