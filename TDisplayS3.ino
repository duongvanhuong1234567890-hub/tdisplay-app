 if (at < 0) {
  if (gYtHistN < YTH_MAX) gYtHistN++;
  at = gYtHistN - 1;
 }
 for (int i = at; i > 0; i--) gYtHist[i] = gYtHist[i - 1];
 gYtHist[0] = s;
 String out;
 for (int i = 0; i < gYtHistN; i++) { out += gYtHist[i]; out += '\n'; }
 prefs.putString("yth", out);
}
