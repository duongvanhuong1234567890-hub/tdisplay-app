 configTime(GMT_OFFSET_SEC, DST_OFFSET_SEC, "pool.ntp.org", "time.google.com");
 }
 if (wifiOK && WiFi.status() != WL_CONNECTED) wifiOK = false;
if (!wifiOK && (now - lastWifiRetry > effectiveWifiRetryMs() || lastWifiRetry == 0)) {
 lastWifiRetry = now;
