 for (int r = 0; r < CH; r++) {
 bool any = false;
 for (int c = 0; c < CW; c++) if (fb[(size_t)r * CW + c]) { any = true; break; }
 if (any) { if (minR < 0) minR = r; maxR = r; }
 }
 if (minR < 0) return false;
 top = (int16_t)(minR - BASE);
 bot = (int16_t)(maxR - BASE);
