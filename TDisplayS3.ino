 for (int x = -scroll; x < gfx->width() + 8; x += 8) {
 gfx->fillTriangle(x, gy, x + 4, gy - 5, x + 8, gy, FLAPPY_GRASS_TOP);
 }
 gfx->fillRect(0, gy, gfx->width(), 3, FLAPPY_GROUND_TOP);
 gfx->fillRect(0, gy + 3, gfx->width(), 4, FLAPPY_GROUND_MID);
