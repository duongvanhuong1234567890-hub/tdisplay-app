 gfxInkCanvas->setFont(font);
 gfxInkCanvas->setTextColor(0xFFFF);
 gfxInkCanvas->setCursor(4, BASE);
 gfxInkCanvas->print("0");
 uint16_t *fb = gfxInkCanvas->getFramebuffer();
