  float A = (a == 1) ? 1.0f : (a == 2 ? 4.0f / 3.0f : 16.0f / 9.0f);
  int cw = ow, ch = oh;
  if ((float)ow / oh > A) cw = (int)(oh * A); else ch = (int)(ow / A);
