 float sc = sEnd + (1.0f - sEnd) * q;
 ww = (int)(cw / sc + 0.5f); if (ww > W) ww = W; if (ww < 2) ww = 2;
 wh = (int)(ch / sc + 0.5f); if (wh > H) wh = H; if (wh < 2) wh = 2;
 wx = (W - ww) / 2;
 wy = (H - wh) / 2;
