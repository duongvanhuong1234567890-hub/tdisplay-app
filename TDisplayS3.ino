static void zmClampRect(int &rx, int &ry, int &rw, int &rh, int W, int H) {
 if (rw < 2) rw = 2;
 if (rh < 2) rh = 2;
 if (rw > W) rw = W;
 if (rh > H) rh = H;
 if (rx < 0) rx = 0;
 if (ry < 0) ry = 0;
 if (rx + rw > W) rx = W - rw;
 if (ry + rh > H) ry = H - rh;
}
static void zmPlayOpen(const uint16_t *src, int W, int H, int rx, int ry, int rw, int rh, const uint16_t *under) {
