 }
 if (canFastRedraw && prevIndex >= 0 && prevIndex < totalRows && prevIndex != menuIndex) {
 int ax, ay, aw, ah, bx, by, bw, bh;
 menuGridCell(prevIndex, totalRows, ax, ay, aw, ah);
