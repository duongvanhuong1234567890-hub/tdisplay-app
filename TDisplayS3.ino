 }
 }
 }
 answer.trim();
 ok = answer.length() > 0;
 } else if (code > 0 && code != 429 && code != 401 && code != 403) {
 httpErrText = gemHttpErrorText(code, http.getString());
 }
 http.end();
 }
 if (code > 0 && code != 200) break;
 }
 if (code <= 0 && !ok) relayDiag(url);
 if (!ok && (code == 429 || code == 404 || code >= 500 || code <= 0)) gGemRateHit = true;
 if (!ok) {
