static void ykGeom(int row, int col, int &x, int &w) {
 const YkCell *r = YK_ROWS[ttSearchPage2 ? 1 : 0][row];
 int n = ykLen(row), sum = 0;
 for (int i = 0; i < n; i++) sum += r[i].w;
 int a = (YK_UNITS - sum) / 2;
 for (int i = 0; i < col; i++) a += r[i].w;
 int span = gfx->width() - 2 * YK_MARGIN + 3;
 int x0 = YK_MARGIN + a * span / YK_UNITS;
 int x1 = YK_MARGIN + (a + r[col].w) * span / YK_UNITS;
 x = x0; w = x1 - x0;
}
static int ykColAt(int row, int sx) {
 int n = ykLen(row);
 for (int c = 0; c < n; c++) {
  int x, w; ykGeom(row, c, x, w);
  if (sx < x + w) return c;
 }
 return n - 1;
}
