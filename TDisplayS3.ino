static void ytRingPop(uint8_t *dst, uint32_t n) {
 YtDl &d = gYtDl;
 uint32_t r = d.rd;
 uint32_t first = min(n, d.cap - r);
 memcpy(dst, d.mem + r, first);
 if (n > first) memcpy(dst + first, d.mem, n - first);
 __sync_synchronize();
 r += n;
 if (r >= d.cap) r -= d.cap;
 d.rd = r;
}
