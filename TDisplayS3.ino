 if (!uiCanvas || !blitStageBuf || cfgPowerSaving || UI_FX_OFF) { drawDestFn(); return; }
 Arduino_GFX *savedGfx = gfx;
 gfx = uiCanvas;
 drawCurrentFn();
 gfx = savedGfx;
