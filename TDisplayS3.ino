 if ((long)(millis() - gThumbBackoffMs) < 0) return;
 for (int s = 0; s < YG_SLOTS; s++) if (gYgSt[s] == 3 && millis() - gYgReqMs > 25000) gYgSt[s] = 0;
 for (int k = 0; k < 6; k++) {
