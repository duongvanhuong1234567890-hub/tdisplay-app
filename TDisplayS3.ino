 if (chRes == 1 || chRes == 2) {
 l2 = tr("Checkmate!", "Chiếu hết!"); c2 = CX_GOLD;
 l3 = (chRes == 1) ? (vs ? String(tr("You win!", "Bạn thắng!")) : String(tr("White wins", "Trắng thắng"))) : (vs ? String(tr("CPU wins", "Máy thắng")) : String(tr("Black wins", "Đen thắng")));
 } else if (chRes == 3) { l2 = tr("Draw", "Hòa"); c2 = CX_GOLD; l3 = tr("Tap New", "Bấm Mới"); }
 else {
 if (chChk) { l2 = tr("CHECK!", "CHIẾU!"); c2 = CX_ALERT; } else l2 = turn;
 l3 = mgThinking ? String(tr("Thinking...", "Đang nghĩ...")) : (chChk ? turn : String(""));
 }
 cxStatus(CH_PX, tr("Chess", "Cờ vua"), l2, c2, l3);
 cxPanel(CH_PX, CH_PW, chMode);
}
static void chSelect(int sq) {
 chSel = sq; memset(chTgt, 0, sizeof(chTgt));
 ChMv l[256]; int n = chLegal(l);
 for (int i = 0; i < n; i++) if (l[i].f == sq) chTgt[l[i].t] = true;
}
static void chUndo() {
 if (!chHn) return;
 chUnmake(chHist[--chHn]);
 if (chMode < 3 && chSide < 0 && chHn) chUnmake(chHist[--chHn]);
 chRefresh(); chPend = false;
}
static void chLoop(bool key) {
 (void)key;
 if (chPend && (long)(millis() - chAiAt) >= 0) {
 mgThinking = true; chDraw();
 ChMv m; bool ok = chBest(chMode, m);
 mgThinking = false;
 if (ok) chPlay(m);
 chRefresh(); chDraw(); return;
 }
 if (!mgT.pressed) return;
 int x = mgT.sx, y = mgT.sy;
 int b = cxHit(x, y, CH_PX, CH_PW);
 if (b == CX_BTN_MODE) { chMode = (chMode + 1) % 4; chReset(); chDraw(); return; }
 if (b == CX_BTN_UNDO) { chUndo(); chDraw(); return; }
 if (b == CX_BTN_NEW) { chReset(); chDraw(); return; }
 if (b == CX_BTN_EXIT) { mgExit(); return; }
 if (chRes || chPend || !mgIn(x, y, CH_BX, CH_BY, CH_BW, CH_BW)) return;
 x = constrain(x, CH_GX, CH_GX + 8 * CH_CELL - 1); y = constrain(y, CH_GY, CH_GY + 8 * CH_CELL - 1);
 int sq = (7 - (x - CH_GX) / CH_CELL) * 8 + (y - CH_GY) / CH_CELL;
 if (chSel >= 0 && chTgt[sq]) {
 ChMv l[256]; int n = chLegal(l);
 for (int i = 0; i < n; i++) if (l[i].f == chSel && l[i].t == sq) { chPlay(l[i]); break; }
 chRefresh(); chDraw(); return;
 }
 int p = chB[sq];
 if (p && (p > 0) == (chSide > 0)) chSelect(sq); else { chSel = -1; memset(chTgt, 0, sizeof(chTgt)); }
 chDraw();
}
