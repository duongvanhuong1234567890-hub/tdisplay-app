 evDoc.clear();
 if (deserializeJson(evDoc, line, DeserializationOption::Filter(evFilter)) != DeserializationError::Ok) continue;
 JsonArray parts = evDoc["candidates"][0]["content"]["parts"].as<JsonArray>();
 for (JsonVariant pv : parts) {
