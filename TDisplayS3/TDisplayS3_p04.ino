 ivShipX += (abs(d) <= 6) ? d : (d > 0 ? 6 : -6);
 ivShipX = mgClamp(ivShipX, 14, MG_W - 14);
 }
 if (!mgTick(25)) return;
 if (now >= ivStepAt) {
 int minC = IV_C, maxC = -1;
 for (int r = 0; r < IV_R; r++) for (int c = 0; c < IV_C; c++) if (ivAlive[r][c]) { if (c < minC) minC = c; if (c > maxC) maxC = c; }
