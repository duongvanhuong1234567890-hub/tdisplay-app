static void ytTrendTask(void *param) {
 String body;
 const bool freshReq = gYtTrendStale;
 gYtTrendStale = false;
 int code = ynGet(pickRelayHost(false) + "/yt/trending?n=" + String(YTT_MAX) + "&lang=" + (cfgVietnamese ? "vi" : "en") + (freshReq ? "&fresh=1" : "") + relayTk(), body, 15000, 30000, false, "trend");
 static YtListItem tmp[YTT_MAX];
 int n = 0;
 if (code == 200 && body.length() > 2) {
  DynamicJsonDocument doc((size_t)body.length() + 1024);
  if (doc.capacity() > 0) {
   DeserializationError derr = deserializeJson(doc, body);
   if (!derr) {
    JsonArray arr = doc.as<JsonArray>();
    if (arr.isNull() && doc.is<JsonObject>()) arr = doc["results"].as<JsonArray>();
    if (!arr.isNull()) {
     for (JsonObject item : arr) {
      if (n >= YTT_MAX) break;
      const char *id = item["id"] | "";
      if (!id[0]) continue;
      tmp[n].id = String(id);
      tmp[n].title = String((const char *)(item["title"] | ""));
      tmp[n].chan = String((const char *)(item["channel"] | ""));
      tmp[n].dur = String((const char *)(item["duration"] | ""));
      tmp[n].views = (uint32_t)(item["views"] | 0);
      n++;
     }
    }
   }
  }
 }
 if (n > 0) {
  for (int i = 0; i < n; i++) gYtTrend[i] = tmp[i];
  gYtTrendN = n;
 }
 gYtTrendMs = millis();
 gYtTrendState = (gYtTrendN > 0) ? 2 : 3;
 vTaskDelete(NULL);
}
