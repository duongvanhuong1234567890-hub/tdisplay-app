 if ((ivDir > 0 && right + 5 > MG_W - 4) || (ivDir < 0 && left - 5 < 4)) { ivDir = -ivDir; ivFy += 8; } else { ivFx += 5 * ivDir; }
 ivAnim++;
 ivStepAt = now + mgMax(40, 30 + ivLeft * 14 - (ivWave - 1) * 25);
 }
 if (now >= ivFireAt) {
 for (int i = 0; i < 2; i++) if (!ivBon[i]) { ivBon[i] = true; ivBx[i] = ivShipX; ivBy[i] = IV_SHIP_Y - 8; ivFireAt = now + 380; break; }
 }
 for (int i = 0; i < 2; i++) if (ivBon[i]) {
 ivBy[i] -= 7;
 if (ivBy[i] < 18) { ivBon[i] = false; continue; }
 for (int r = 0; r < IV_R && ivBon[i]; r++) for (int c = 0; c < IV_C; c++) if (ivAlive[r][c]) {
 int x = ivFx + c * IV_PX, y = ivFy + r * IV_PY;
 if (ivBx[i] >= x && ivBx[i] <= x + 16 && ivBy[i] >= y && ivBy[i] <= y + 16) {
 ivAlive[r][c] = false; ivLeft--; ivBon[i] = false; ivScore += 10 * (IV_R - r); break;
 }
 }
 }
 if (random(100) < 3 + ivWave) {
 for (int i = 0; i < 3; i++) if (!ivEon[i]) {
 int c = random(IV_C);
 for (int r = IV_R - 1; r >= 0; r--) if (ivAlive[r][c]) { ivEon[i] = true; ivEx[i] = ivFx + c * IV_PX + 8; ivEy[i] = ivFy + r * IV_PY + 16; break; }
 break;
 }
 }
 for (int i = 0; i < 3; i++) if (ivEon[i]) {
 ivEy[i] += 3.2f + 0.3f * ivWave;
 if (ivEy[i] > MG_H) { ivEon[i] = false; continue; }
 if (now >= ivHurtUntil && ivEy[i] >= IV_SHIP_Y - 6 && ivEy[i] <= IV_SHIP_Y + 8 && fabsf(ivEx[i] - ivShipX) <= 12) {
 ivEon[i] = false; ivLives--; ivHurtUntil = now + 1200;
 if (ivLives <= 0) { ivOver = true; ivOverAt = now; if (ivScore > ivBest) ivBest = ivScore; }
 }
 }
 for (int r = 0; r < IV_R; r++) for (int c = 0; c < IV_C; c++) if (ivAlive[r][c] && ivFy + r * IV_PY + 16 >= IV_SHIP_Y - 6) {
 ivLives = 0; ivOver = true; ivOverAt = now; if (ivScore > ivBest) ivBest = ivScore;
 }
