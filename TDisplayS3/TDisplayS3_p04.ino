static bool phWriteRaw(const char *path, const uint16_t *buf, size_t bytes) {
 void *dst = lfsOpenWrite(path);
 if (!dst) return false;
 bool ok = true;
 const uint8_t *p = (const uint8_t *)buf;
 size_t left = bytes;
 while (left > 0 && ok) { size_t c = left > 4096 ? 4096 : left; ok = lfsWriteChunk(dst, p, c); p += c; left -= c; esp_task_wdt_reset(); }
 lfsCloseWrite(dst);
 if (!ok) lfsRemove(path);
 return ok;
}
static void phSetWallpaper(int target) {
 if (!lfsBegin()) { showMessage(tr("No LittleFS partition", "Không có phân vùng LittleFS")); return; }
 if (target == 3) {
  lfsRemove(WP_LOCK_FILE); lfsRemove(WP_MENU_FILE);
 } else {
  if (!fzBuf || fzW <= 0 || fzH <= 0) { showMessage(tr("Open a JPG photo first", "Hãy mở ảnh JPG trước")); return; }
  const int W = gfx->width(), H = gfx->height();
  size_t bytes = (size_t)W * H * sizeof(uint16_t);
  size_t need = bytes * (target == 2 ? 2 : 1) + 8192;
  if (lfsFreeBytes() < need) { showMessage(tr("Not enough space on device", "Không đủ bộ nhớ trong máy")); return; }
  uint16_t *buf = (uint16_t *)allocBuffer(bytes);
  if (!buf) { showMessage(tr("Out of memory", "Hết bộ nhớ")); return; }
  float k = max((float)W / fzW, (float)H / fzH);
  fzRender(buf, fzW / 2.0f, fzH / 2.0f, k);
  bool ok = true;
  if (target == 0 || target == 2) ok = phWriteRaw(WP_LOCK_FILE, buf, bytes) && ok;
  if (target == 1 || target == 2) ok = phWriteRaw(WP_MENU_FILE, buf, bytes) && ok;
  free(buf);
  if (!ok) { showMessage(tr("Cannot save wallpaper", "Không lưu được hình nền")); return; }
  if ((target == 0 || target == 2) && cfgActivated && !cfgWallpaperLock) { cfgWallpaperLock = true; prefs.putBool("wplock", true); }
 }
 if (target == 0 || target == 2 || target == 3) { lockWallpaperBufAttempted = false; lockWallpaperBufReady = false; ensureLockWallpaperBuf(); }
 if (target == 1 || target == 2 || target == 3) { menuWallpaperBufAttempted = false; menuWallpaperBufReady = false; ensureMenuWallpaperBuf(); }
 showMessage(target == 3 ? tr("Default wallpaper restored", "Đã khôi phục nền mặc định") : tr("Wallpaper set", "Đã đặt hình nền"));
}
static bool phDeleteAny(int idx) {
 if (idx < 0 || idx >= photoCount) return false;
 int before = photoCount;
 if (photoIsInternal[idx]) {
  deletePhotoFromInternal(idx);
  return photoCount < before;
 }
 String name = photoList[idx];
 if (!confirmDeletePhoto(name)) return false;
 String key = phKey(idx);
 bool ok = sd.remove((String(PHOTO_DIR) + "/" + name).c_str());
 if (!ok) { showMessage(tr("Cannot delete photo", "Không xoá được ảnh")); return false; }
 sd.remove((String(PH_THUMB_DIR) + "/" + key + ".t").c_str());
 sd.remove((String(PH_THUMB_DIR) + "/" + key + ".r").c_str());
 scanPhotos();
 if (!hasFullAccess() && photoCount > FREE_MAX_PHOTOS) photoCount = FREE_MAX_PHOTOS;
 if (photoIndex >= photoCount) photoIndex = photoCount - 1;
 if (photoIndex < 0) photoIndex = 0;
 showMessage(tr("Photo deleted", "Đã xoá ảnh"));
 return true;
}
