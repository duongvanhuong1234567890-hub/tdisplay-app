enum { PHOTO_OK = 0, PHOTO_ERR_FORMAT = 1, PHOTO_ERR_DECODE = 2, PHOTO_ERR_NOLIB = 3 };
uint16_t *gLastFrame = nullptr;
int gLastFrameW = 0, gLastFrameH = 0;
static void lastFrameAlloc(int w, int h) {
 if (gLastFrame) { free(gLastFrame); gLastFrame = nullptr; }
 gLastFrame = (uint16_t *)ps_malloc((size_t)w * h * sizeof(uint16_t));
 if (gLastFrame) { memset(gLastFrame, 0, (size_t)w * h * sizeof(uint16_t)); gLastFrameW = w; gLastFrameH = h; }
}
static void lastFrameFree() { if (gLastFrame) { free(gLastFrame); gLastFrame = nullptr; } }
static void lastFrameStore(int x, int y, int w, int h, const uint16_t *bm) {
 if (!gLastFrame) return;
 for (int j = 0; j < h; j++) {
 int yy = y + j;
 if (yy < 0 || yy >= gLastFrameH) continue;
 int x0 = x < 0 ? -x : 0;
 int x1 = (x + w > gLastFrameW) ? (gLastFrameW - x) : w;
 if (x1 <= x0) continue;
 memcpy(gLastFrame + (size_t)yy * gLastFrameW + x + x0, bm + (size_t)j * w + x0, (size_t)(x1 - x0) * sizeof(uint16_t));
 }
}
static uint16_t phXMap[512];
static uint16_t phYMap[512];
static uint16_t phRow[512];
static int phDw = 0, phDh = 0, phOx = 0, phOy = 0, phNextDy = 0;
static void photoFitDims(int srcW, int srcH, int &dw, int &dh) {
 int W = gfx->width(), H = gfx->height();
 if (srcW <= W && srcH <= H) { dw = srcW; dh = srcH; return; }
 if ((int64_t)srcW * H >= (int64_t)srcH * W) { dw = W; dh = (int)((int64_t)srcH * W / srcW); }
 else { dh = H; dw = (int)((int64_t)srcW * H / srcH); }
 if (dw < 1) dw = 1;
 if (dh < 1) dh = 1;
}
void photoSetupFit(int srcW, int srcH) {
 photoFitDims(srcW, srcH, phDw, phDh);
 if (phDw > 512) phDw = 512;
 if (phDh > 512) phDh = 512;
 phOx = (gfx->width() - phDw) / 2;
 phOy = (gfx->height() - phDh) / 2;
 for (int i = 0; i < phDw; i++) phXMap[i] = (uint16_t)(((uint64_t)(2 * i + 1) * srcW) / (2 * phDw));
 for (int i = 0; i < phDh; i++) phYMap[i] = (uint16_t)(((uint64_t)(2 * i + 1) * srcH) / (2 * phDh));
 phNextDy = 0;
}
static int phLower(const uint16_t *m, int n, int v) {
 int lo = 0, hi = n;
 while (lo < hi) { int mid = (lo + hi) >> 1; if (m[mid] < v) lo = mid + 1; else hi = mid; }
 return lo;
}
static inline void phEmitRow(int dy, const uint16_t *srcRow) {
 for (int dx = 0; dx < phDw; dx++) phRow[dx] = srcRow[phXMap[dx]];
 lastFrameStore(phOx, phOy + dy, phDw, 1, phRow);
 gfx->draw16bitRGBBitmap(phOx, phOy + dy, phRow, phDw, 1);
}
bool photoFitJpegCallback(int16_t x, int16_t y, uint16_t w, uint16_t h, uint16_t *bitmap) {
 static uint16_t blk[32 * 32];
 if (w > 32 || h > 32) return true;
 int dx0 = phLower(phXMap, phDw, x), dx1 = phLower(phXMap, phDw, x + w);
 int dy0 = phLower(phYMap, phDh, y), dy1 = phLower(phYMap, phDh, y + h);
 int cw = dx1 - dx0, ch = dy1 - dy0;
 if (cw <= 0 || ch <= 0) return true;
 for (int j = 0; j < ch; j++) {
  const uint16_t *srow = bitmap + (size_t)(phYMap[dy0 + j] - y) * w;
  uint16_t *d = blk + (size_t)j * cw;
  for (int i = 0; i < cw; i++) d[i] = srow[phXMap[dx0 + i] - x];
 }
 lastFrameStore(phOx + dx0, phOy + dy0, cw, ch, blk);
 gfx->draw16bitRGBBitmap(phOx + dx0, phOy + dy0, blk, cw, ch);
 return true;
}
int photoDrawJpeg(const uint8_t *buf, uint32_t len) {
 uint16_t jw = 0, jh = 0;
 if (TJpgDec.getJpgSize(&jw, &jh, buf, len) != JDR_OK || jw == 0 || jh == 0) return PHOTO_ERR_DECODE;
 int fw, fh;
 photoFitDims(jw, jh, fw, fh);
 uint8_t scale = 1;
 while (scale < 8 && (jw / (scale * 2)) >= fw && (jh / (scale * 2)) >= fh) scale *= 2;
 TJpgDec.setJpgScale(scale);
 int dispW = jw / scale, dispH = jh / scale;
 JRESULT r;
 if (dispW <= gfx->width() && dispH <= gfx->height()) {
  int16_t ox = (gfx->width() - dispW) / 2, oy = (gfx->height() - dispH) / 2;
  r = TJpgDec.drawJpg(ox, oy, buf, len);
 } else {
  photoSetupFit(dispW, dispH);
  TJpgDec.setCallback(photoFitJpegCallback);
  r = TJpgDec.drawJpg(0, 0, buf, len);
  TJpgDec.setCallback(tftOutputCallback);
 }
 TJpgDec.setJpgScale(1);
 return r == JDR_OK ? PHOTO_OK : PHOTO_ERR_DECODE;
}
#ifdef HAVE_PNGDEC
static PNG *photoPng = nullptr;
static void photoPngDraw(PNGDRAW *pDraw) {
 static uint16_t line[1024];
 if (pDraw->iWidth > 1024) return;
 int y = pDraw->y;
 while (phNextDy < phDh && phYMap[phNextDy] < y) phNextDy++;
 if (phNextDy >= phDh || phYMap[phNextDy] != y) return;
 photoPng->getLineAsRGB565(pDraw, line, PNG_RGB565_LITTLE_ENDIAN, 0x00000000);
 while (phNextDy < phDh && phYMap[phNextDy] == y) { phEmitRow(phNextDy, line); phNextDy++; }
}
#endif
int photoDrawPng(const uint8_t *buf, uint32_t len) {
#ifdef HAVE_PNGDEC
 photoPng = new (std::nothrow) PNG();
 if (!photoPng) return PHOTO_ERR_DECODE;
 int rc = photoPng->openRAM((uint8_t *)buf, (int)len, photoPngDraw);
 if (rc != PNG_SUCCESS || photoPng->getWidth() > 1024 || photoPng->getHeight() > 65535) { delete photoPng; photoPng = nullptr; return PHOTO_ERR_DECODE; }
 photoSetupFit(photoPng->getWidth(), photoPng->getHeight());
 rc = photoPng->decode(nullptr, 0);
 photoPng->close();
 delete photoPng; photoPng = nullptr;
 return rc == PNG_SUCCESS ? PHOTO_OK : PHOTO_ERR_DECODE;
#else
 return PHOTO_ERR_NOLIB;
#endif
}
int photoDrawBmp(const uint8_t *b, uint32_t len) {
 if (len < 54) return PHOTO_ERR_DECODE;
 auto rd32 = [&](int o) { return (uint32_t)b[o] | ((uint32_t)b[o+1] << 8) | ((uint32_t)b[o+2] << 16) | ((uint32_t)b[o+3] << 24); };
 uint32_t dataOff = rd32(10);
 int32_t w = (int32_t)rd32(18), h = (int32_t)rd32(22);
 uint16_t bpp = b[28] | (b[29] << 8);
 uint32_t comp = rd32(30);
 bool topDown = h < 0; if (h < 0) h = -h;
 if (w <= 0 || h <= 0 || w > 65535 || h > 65535 || (bpp != 24 && bpp != 32) || (comp != 0 && comp != 3)) return PHOTO_ERR_DECODE;
 uint32_t bytesPP = bpp / 8;
 uint32_t stride = (w * bytesPP + 3) & ~3u;
 if ((uint64_t)dataOff + (uint64_t)stride * h > len) return PHOTO_ERR_DECODE;
 photoSetupFit(w, h);
 for (int dy = 0; dy < phDh; dy++) {
  int y = phYMap[dy];
  const uint8_t *row = b + dataOff + (size_t)(topDown ? y : (h - 1 - y)) * stride;
  for (int dx = 0; dx < phDw; dx++) {
   const uint8_t *px = row + (size_t)phXMap[dx] * bytesPP;
   phRow[dx] = ((px[2] & 0xF8) << 8) | ((px[1] & 0xFC) << 3) | (px[0] >> 3);
  }
  lastFrameStore(phOx, phOy + dy, phDw, 1, phRow);
  gfx->draw16bitRGBBitmap(phOx, phOy + dy, phRow, phDw, 1);
 }
 return PHOTO_OK;
}
static uint16_t *fzBuf = nullptr;
static int fzW = 0, fzH = 0;
#define FZ_MAX_BYTES 3145728UL
static bool fzCb(int16_t x, int16_t y, uint16_t w, uint16_t h, uint16_t *bm) {
 if (!fzBuf) return false;
 for (int r = 0; r < h; r++) {
  int yy = y + r;
  if (yy < 0 || yy >= fzH) continue;
  int x0 = x < 0 ? -x : 0;
  int x1 = (x + w > fzW) ? (fzW - x) : w;
  if (x1 <= x0) continue;
  memcpy(fzBuf + (size_t)yy * fzW + x + x0, bm + (size_t)r * w + x0, (size_t)(x1 - x0) * sizeof(uint16_t));
 }
 return true;
}
static void fzFree() { if (fzBuf) { free(fzBuf); fzBuf = nullptr; } fzW = fzH = 0; }
static void fzClamp(float &cx, float &cy, float k) {
 float W = (float)gfx->width(), H = (float)gfx->height();
 float hw = W / (2 * k), hh = H / (2 * k);
 if (2 * hw >= fzW) cx = fzW / 2.0f; else { if (cx < hw) cx = hw; if (cx > fzW - hw) cx = fzW - hw; }
 if (2 * hh >= fzH) cy = fzH / 2.0f; else { if (cy < hh) cy = hh; if (cy > fzH - hh) cy = fzH - hh; }
}
static void fzRender(uint16_t *frame, float cx, float cy, float k) {
 int W = gfx->width(), H = gfx->height();
 float inv = 1.0f / k;
 int n = (k >= 1.0f) ? 1 : (int)ceilf(inv);
 if (n > 4) n = 4;
 static float colX[512];
 if (W > 512) return;
 for (int sx = 0; sx < W; sx++) colX[sx] = cx + (sx - W / 2.0f) * inv;
 float sub = inv / n;
 for (int sy = 0; sy < H; sy++) {
  float by = cy + (sy - H / 2.0f) * inv;
  uint16_t *row = frame + (size_t)sy * W;
  for (int sx = 0; sx < W; sx++) {
   float bx = colX[sx];
   if (bx < 0 || by < 0 || bx >= fzW || by >= fzH) { row[sx] = 0; continue; }
   if (n == 1) { row[sx] = fzBuf[(size_t)(int)by * fzW + (int)bx]; continue; }
   uint32_t r = 0, g = 0, b = 0, c = 0;
   for (int j = 0; j < n; j++) {
    int iy = (int)(by - inv / 2 + (j + 0.5f) * sub);
    if (iy < 0) iy = 0; if (iy >= fzH) iy = fzH - 1;
    for (int i = 0; i < n; i++) {
     int ix = (int)(bx - inv / 2 + (i + 0.5f) * sub);
     if (ix < 0) ix = 0; if (ix >= fzW) ix = fzW - 1;
     uint16_t p = fzBuf[(size_t)iy * fzW + ix];
     r += (p >> 11) & 31; g += (p >> 5) & 63; b += p & 31; c++;
    }
   }
   row[sx] = (uint16_t)(((r / c) << 11) | ((g / c) << 5) | (b / c));
  }
 }
}
static int gFzJw = 0, gFzJh = 0;
static int fzDecodeJpeg(const uint8_t *buf, uint32_t got) {
 uint16_t jw = 0, jh = 0;
 fzFree();
 if (TJpgDec.getJpgSize(&jw, &jh, buf, got) != JDR_OK || jw == 0 || jh == 0) return -1;
 gFzJw = jw; gFzJh = jh;
 int sc = 1;
 while (sc < 8 && (size_t)((jw + sc - 1) / sc) * ((jh + sc - 1) / sc) * 2 > FZ_MAX_BYTES) sc *= 2;
 fzW = (jw + sc - 1) / sc; fzH = (jh + sc - 1) / sc;
 fzBuf = (uint16_t *)allocBuffer((size_t)fzW * fzH * sizeof(uint16_t));
 if (!fzBuf) { fzW = fzH = 0; return -1; }
 memset(fzBuf, 0, (size_t)fzW * fzH * sizeof(uint16_t));
 TJpgDec.setCallback(fzCb);
 TJpgDec.setJpgScale(sc);
 JRESULT jr = TJpgDec.drawJpg(0, 0, buf, got);
 TJpgDec.setJpgScale(1);
 TJpgDec.setCallback(tftOutputCallback);
 if (jr != JDR_OK) { fzFree(); return -1; }
 return 0;
}
static bool fzRotate(int r) {
 r &= 3;
 if (r == 0 || !fzBuf) return true;
 int w = fzW, h = fzH;
 uint16_t *nb = (uint16_t *)allocBuffer((size_t)w * h * sizeof(uint16_t));
 if (!nb) return false;
 if (r == 2) {
  for (int y = 0; y < h; y++) for (int x = 0; x < w; x++) nb[(size_t)y * w + x] = fzBuf[(size_t)(h - 1 - y) * w + (w - 1 - x)];
 } else {
  for (int y = 0; y < w; y++) {
   for (int x = 0; x < h; x++) {
    nb[(size_t)y * h + x] = (r == 1) ? fzBuf[(size_t)(h - 1 - x) * w + y] : fzBuf[(size_t)x * w + (w - 1 - y)];
   }
  }
  fzW = h; fzH = w;
 }
 free(fzBuf); fzBuf = nb;
 return true;
}
static bool gPhotoZoomWant = false, gPhotoZoomOk = false;
void showPhoto(int idx) {
 uint8_t *buf = nullptr;
 uint32_t fsize = 0;
 if (photoIsInternal[idx]) {
 String path = String(INTERNAL_PHOTO_DIR) + "/" + photoList[idx];
 fsize = lfsFileSize(path.c_str());
 if (fsize == 0) { showMessage(tr("Cannot open photo", "Không mở được ảnh")); return; }
 buf = allocBuffer(fsize);
 if (!buf) { showMessage(tr("Out of memory", "Hết bộ nhớ")); return; }
 if (!lfsReadFileInto(path.c_str(), buf, fsize)) {
 free(buf); showMessage(tr("Cannot open photo", "Không mở được ảnh")); return;
