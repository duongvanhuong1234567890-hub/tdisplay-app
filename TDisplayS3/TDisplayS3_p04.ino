static void chRefresh() {
 ChMv l[256]; int n = chLegal(l);
 chChk = chInCheck(chSide); chRes = 0;
 if (!n) chRes = chChk ? (chSide > 0 ? 2 : 1) : 3;
 else if (chHalf >= 100 || chInsufficient() || chHn >= CH_MAXH) chRes = 3;
 chSel = -1; memset(chTgt, 0, sizeof(chTgt));
 chPend = (chRes == 0 && chMode < 3 && chSide < 0);
