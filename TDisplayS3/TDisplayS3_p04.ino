 if (b == CX_BTN_NEW) { chReset(); chDraw(); return; }
 if (b == CX_BTN_EXIT) { mgExit(); return; }
 if (chRes || chPend || !mgIn(x, y, CH_BX, CH_BY, CH_BW, CH_BW)) return;
 x = constrain(x, CH_GX, CH_GX + 8 * CH_CELL - 1); y = constrain(y, CH_GY, CH_GY + 8 * CH_CELL - 1);
 int sq = (7 - (x - CH_GX) / CH_CELL) * 8 + (y - CH_GY) / CH_CELL;
 if (chSel >= 0 && chTgt[sq]) {
 ChMv l[256]; int n = chLegal(l);
 for (int i = 0; i < n; i++) if (l[i].f == chSel && l[i].t == sq) { chPlay(l[i]); break; }
 chRefresh(); chDraw(); return;
 }
 int p = chB[sq];
 if (p && (p > 0) == (chSide > 0)) chSelect(sq); else { chSel = -1; memset(chTgt, 0, sizeof(chTgt)); }
 chDraw();
}
