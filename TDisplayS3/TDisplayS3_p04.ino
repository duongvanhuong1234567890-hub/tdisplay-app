 }
 for (int sq = 0; sq < 64; sq++) {
 int r = sq >> 3, c = sq & 7;
 bool dark = (r + c) & 1;
 uint16_t lab = dark ? LIGHT : DARKC;
 if (c == 0) chTiny(chCx(sq), chCy(sq), 1, 1, 7 - r, lab);
 if (r == 7) chTiny(chCx(sq), chCy(sq), CH_CELL - 4, CH_CELL - 6, 8 + c, lab);
 }
 for (int sq = 0; sq < 64; sq++) {
 int r = sq >> 3, c = sq & 7, x = chCx(sq), y = chCy(sq);
 if (chB[sq]) chSprite(x + 1, y + 1, (chB[sq] > 0 ? 0 : 6) + chAbs(chB[sq]) - 1, cc[sq]);
