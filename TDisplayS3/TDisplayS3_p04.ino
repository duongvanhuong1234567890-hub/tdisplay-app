static void phWaitRelease() {
 int16_t a, b; unsigned long w = millis();
 while (touchReadDebounced(a, b) && millis() - w < 1500) delay(10);
}
static int phSheet(const char *title, const char *const *items, int n) {
 phWaitRelease();
 { int16_t a0, b0; unsigned long tf = millis(); while (millis() - tf < 150) { touchTapScreen(a0, b0); esp_task_wdt_reset(); delay(5); } }
 evt_boot_single = evt_boot_double = evt_boot_long = false;
 evt_pin14_single = evt_pin14_double = evt_pin14_long = false;
 const int W = gfx->width(), H = gfx->height();
 int rowH = min(30, (H - 24) / (n + 1));
 int y0 = H - (n + 1) * rowH - 4;
 int sel = 0;
 bool dirty = true;
 while (true) {
  if (dirty) {
   dirty = false;
   UiCanvasGuard _sg;
   gfx->fillRect(0, y0, W, H - y0, 0x2104);
   gfxSetTextColor(COLOR_WHITE, 0x2104);
   gfxDrawAligned(title, W / 2, y0 + rowH / 2, DATUM_MC);
   for (int i = 0; i < n; i++) {
    int ry = y0 + (i + 1) * rowH;
    uint16_t bg = (i == sel) ? colorAccent : 0x2104;
    gfx->fillRect(4, ry, W - 8, rowH - 2, bg);
    gfxSetTextColor((i == sel) ? (uint16_t)COLOR_BLACK : (uint16_t)COLOR_WHITE, bg);
    gfxDrawAligned(items[i], 12, ry + rowH / 2 - 1, DATUM_ML);
   }
  }
  handleButtons(DOUBLE_WINDOW_MS);
  if (evt_pin14_single) { evt_pin14_single = false; sel = (sel + 1) % n; dirty = true; }
  if (evt_boot_single) { evt_boot_single = false; sel = (sel - 1 + n) % n; dirty = true; }
  if (evt_pin14_double) { evt_pin14_double = false; return sel; }
  if (evt_boot_double) { evt_boot_double = false; return -1; }
  int16_t tx, ty;
  if (touchTapScreen(tx, ty)) {
   if (ty < y0) return -1;
   int i = (ty - y0 - rowH) / rowH;
   if (ty >= y0 + rowH && i >= 0 && i < n) return i;
  }
  esp_task_wdt_reset();
  delay(15);
 }
}
