static void ykGeom(int row, int col, int &x, int &w) {
 const YkCell *r = YK_ROWS[ttSearchPage2 ? 1 : 0][row];
 int n = ykLen(row), sum = 0;
 for (int i = 0; i < n; i++) sum += r[i].w;
