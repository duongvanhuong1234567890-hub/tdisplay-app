 it[4] = photoIsInternal[idx] ? tr("Already on device", "Đã có trong máy") : tr("Move to device", "Di chuyển vào máy");
 it[5] = tr("Delete", "Xoá ảnh");
 int r = phSheet(tr("Photo options", "Tuỳ chọn ảnh"), it, 6);
 if (r == 4) return 5;
