 int newRow = videoIndex - videoTop;
 if (newRow >= 0 && newRow < maxVisible) drawVideoRow(videoIndex, newRow, startY, rowH);
 gfx->endWrite();
 lastDrawnVideoIndex = videoIndex;
 lastDrawnVideoTop = videoTop;
