String photoFitName(const String &name, int maxW) {
 int16_t x1, y1; uint16_t w, h;
 gfx->getTextBounds(name.c_str(), 0, 0, &x1, &y1, &w, &h);
 if ((int)w <= maxW) return name;
 int dot = name.lastIndexOf('.');
 String ext = (dot > 0 && (int)name.length() - dot <= 6) ? name.substring(dot) : String("");
 String base = ext.length() ? name.substring(0, dot) : name;
 while (base.length() > 1) {
 base.remove(utf8LastCharStart(base));
 String t = base + "~" + ext;
 gfx->getTextBounds(t.c_str(), 0, 0, &x1, &y1, &w, &h);
 if ((int)w <= maxW) return t;
 }
 return base + "~" + ext;
}
String photoShortName(const String &name) {
 if (name.length() <= 28) return name;
 uint32_t hsh = 2166136261u;
 for (size_t i = 0; i < name.length(); i++) { hsh ^= (uint8_t)name[i]; hsh *= 16777619u; }
 int dot = name.lastIndexOf('.');
 String ext = (dot > 0 && (int)name.length() - dot <= 6) ? name.substring(dot) : String(".jpg");
 String pre = "";
 for (int i = 0; i < (int)name.length() && pre.length() < 12; i++) {
 char c = name[i];
 if (isalnum((unsigned char)c) || c == '-') pre += c; else if (c == '_' || c == ' ') pre += '_';
 }
 char hx[9]; snprintf(hx, sizeof(hx), "%08x", (unsigned)hsh);
 return pre + "_" + String(hx) + ext;
}
