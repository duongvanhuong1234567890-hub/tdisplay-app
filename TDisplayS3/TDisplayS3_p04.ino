 if (videoTop > fileCount - maxVisible) videoTop = max(0, fileCount - maxVisible);
 if (videoTop != lastDrawnVideoTop) { drawVideoRowsOnly(rowH, startY, maxVisible); return; }
 CanvasRectPush _rp(0, startY, gfx->width(), maxVisible * rowH);
