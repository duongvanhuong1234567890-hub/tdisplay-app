 FsFile f = sd.open(path.c_str(), O_READ);
 if (!f) { showMessage(tr("Cannot open photo", "Không mở được ảnh")); return; }
 fsize = f.fileSize();
 buf = allocBuffer(fsize);
 if (!buf) { f.close(); showMessage(tr("Out of memory", "Hết bộ nhớ")); return; }
 int rd = f.read(buf, fsize);
 f.close();
 if (rd < 0 || (uint32_t)rd != fsize) { free(buf); showMessage(tr("Cannot open photo", "Không mở được ảnh")); return; }
 }
 bool isJpeg = fsize > 3 && buf[0] == 0xFF && buf[1] == 0xD8;
 bool isPng = fsize > 8 && buf[0] == 0x89 && buf[1] == 'P' && buf[2] == 'N' && buf[3] == 'G';
 bool isBmp = fsize > 2 && buf[0] == 'B' && buf[1] == 'M';
 int status = PHOTO_ERR_FORMAT;
 gPhotoZoomOk = false;
 {
 UiCanvasGuard _uiGuard;
 gfx->fillScreen(COLOR_BLACK);
 if (isJpeg) { if (gPhotoZoomWant && fzDecodeJpeg(buf, fsize) == 0) { uint8_t rr = phRotGet(idx); if (rr) fzRotate(rr); gPhotoZoomOk = true; status = PHOTO_OK; } else status = photoDrawJpeg(buf, fsize); } else if (isPng) { status = photoDrawPng(buf, fsize); } else if (isBmp) { status = photoDrawBmp(buf, fsize); }
 }
 free(buf);
 switch (status) {
 case PHOTO_OK: break;
 case PHOTO_ERR_NOLIB:
 showMessage(tr("PNG needs library PNGdec", "PNG cần thư viện PNGdec"), tr("Or convert to .jpg", "Hoặc chuyển sang .jpg"));
 break;
 case PHOTO_ERR_DECODE:
 showMessage(tr("Cannot decode photo", "Không giải mã được ảnh"), tr("Progressive/damaged file - re-save as .jpg", "Ảnh progressive/hỏng - lưu lại dạng .jpg"));
 break;
 default:
 showMessage(tr("Format not supported", "Định dạng chưa hỗ trợ"), tr("Use jpg / png / bmp", "Dùng jpg / png / bmp"));
 break;
 }
}
void copyPhotoToInternal(int idx) {
 if (photoIsInternal[idx]) {
 showMessage(tr("Already on device", "Ảnh đã có trong máy"));
 return;
 }
 if (photoCount >= MAX_PHOTOS) {
 showMessage(tr("Photo list is full", "Danh sách ảnh đã đầy"));
 return;
 }
 String srcPath = String(PHOTO_DIR) + "/" + photoList[idx];
 FsFile src = sd.open(srcPath.c_str(), O_READ);
 if (!src) { showMessage(tr("Cannot open photo", "Không mở được ảnh")); return; }
 uint32_t fsize = src.fileSize();
 if (!lfsBegin()) {
 src.close();
 showMessage(tr("No LittleFS partition", "Không có phân vùng LittleFS"),
 tr("Use a partition scheme with SPIFFS", "Chọn Partition Scheme có SPIFFS"));
 return;
 }
 if (lfsFreeBytes() < (uint64_t)(fsize + 8192)) {
 src.close();
 char l2[40];
 snprintf(l2, sizeof(l2), tr("Free %lu KB, need %lu KB", "Trống %lu KB, cần %lu KB"),
 (unsigned long)(lfsFreeBytes() / 1024), (unsigned long)((fsize + 8192) / 1024));
 showMessage(tr("Not enough space on device", "Không đủ bộ nhớ trong máy"), l2);
 return;
 }
 String dstPath = String(INTERNAL_PHOTO_DIR) + "/" + photoShortName(photoList[idx]);
 if (lfsFileSize(dstPath.c_str()) > 0) {
 src.close();
 showMessage(tr("Already on device", "Ảnh đã có trong máy"));
 return;
 }
 lfsEnsureDir(INTERNAL_PHOTO_DIR);
 void* dst = lfsOpenWrite(dstPath.c_str());
 if (!dst) {
 src.close();
 showMessage(tr("Cannot save photo", "Không lưu được ảnh"));
 return;
 }
 const size_t BIG = 32 * 1024;
 uint8_t small[4096];
 uint8_t *big = (fsize > sizeof(small)) ? allocBuffer(BIG) : nullptr;
 uint8_t *buf = big ? big : small;
 size_t bufSize = big ? BIG : sizeof(small);
 bool ok = true;
 uint32_t remaining = fsize;
 int lastPct = -1;
 while (remaining > 0) {
 size_t chunk = remaining < bufSize ? remaining : bufSize;
 size_t got = src.read(buf, chunk);
 if (got == 0 || !lfsWriteChunk(dst, buf, got)) { ok = false; break; }
 remaining -= got;
 int pct = (int)(((uint64_t)(fsize - remaining) * 100) / fsize);
 if (pct / 10 != lastPct / 10) {
 lastPct = pct;
 char l1[32];
 snprintf(l1, sizeof(l1), "%s %d%%", tr("Saving...", "Đang lưu..."), pct);
 gfx->fillScreen(COLOR_BLACK);
 gfxSetTextColor(COLOR_WHITE, COLOR_BLACK);
 gfxDrawAligned(l1, gfx->width() / 2, gfx->height() / 2, DATUM_MC);
 }
 esp_task_wdt_reset();
 }
 if (big) free(big);
 src.close();
 lfsCloseWrite(dst);
 if (!ok) {
 lfsRemove(dstPath.c_str());
 showMessage(tr("Copy failed", "Sao chép thất bại"));
 return;
 }
 scanInternalPhotos();
 showMessage(tr("Saved to device", "Đã lưu vào máy"));
}
