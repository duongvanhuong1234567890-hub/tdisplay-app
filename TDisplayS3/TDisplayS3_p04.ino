}
static int phHit(int16_t sx, int16_t sy) {
 if (sy < gThTop0 || sy >= phAreaBottom()) return -1;
 int rel = sy - gThTop0 - gThGap + gThScroll;
 if (rel < 0) return -1;
 int row = rel / gThRowH, ry = rel % gThRowH;
 if (ry >= gThCell) return -1;
 int cx = sx - gThGap;
 if (cx < 0) return -1;
 int col = cx / (gThCell + gThGap), rx = cx % (gThCell + gThGap);
 if (col >= gThCols || rx >= gThCell) return -1;
 int i = row * gThCols + col;
 return (i < photoCount) ? i : -1;
}
static bool phGenTick() {
 if (photoCount == 0) return false;
 int firstRow = max(0, (gThScroll - gThGap) / gThRowH);
 int lastRow = (gThScroll + phAreaBottom() - gThTop0) / gThRowH + 1;
 for (int pass = 0; pass < 2; pass++) {
  int a = pass == 0 ? firstRow * gThCols : 0;
  int b = pass == 0 ? min(photoCount, (lastRow + 1) * gThCols) : photoCount;
  for (int i = a; i < b; i++) {
   if (gThState[i] != 2) continue;
   if (!phIsJpegName(photoList[i])) { gThState[i] = 3; continue; }
   bool ok = phThumbMake(i);
   gThState[i] = ok ? 0 : 3;
   return true;
  }
 }
 return false;
}
