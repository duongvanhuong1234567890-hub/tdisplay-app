static inline void xqAdd(XqMv *o, int &n, int f, int t) { o[n].f = f; o[n].t = t; o[n].sc = 0; n++; }
static int xqGen(XqMv *o, bool caps) {
 int n = 0, s = xqSide;
 for (int sq = 0; sq < 90; sq++) {
 int p = xqB[sq];
 if (!p || (p > 0) != (s > 0)) continue;
 int t = chAbs(p), r = sq / 9, c = sq % 9;
 if (t == XQ_R || t == XQ_C) {
 for (int i = 0; i < 4; i++) {
 int rr = r + XQ_O[i][0], cc = c + XQ_O[i][1];
 bool screen = false;
 while (rr >= 0 && rr < 10 && cc >= 0 && cc < 9) {
 int q = xqB[rr * 9 + cc];
 if (t == XQ_R) {
 if (q) { if ((q > 0) != (s > 0)) xqAdd(o, n, sq, rr * 9 + cc); break; }
 if (!caps) xqAdd(o, n, sq, rr * 9 + cc);
 } else {
 if (!screen) { if (q) screen = true; else if (!caps) xqAdd(o, n, sq, rr * 9 + cc); }
 else if (q) { if ((q > 0) != (s > 0)) xqAdd(o, n, sq, rr * 9 + cc); break; }
 }
 rr += XQ_O[i][0]; cc += XQ_O[i][1];
 }
 }
 } else if (t == XQ_H) {
 for (int i = 0; i < 8; i++) {
 int dr = XQ_H8[i][0], dc = XQ_H8[i][1], rr = r + dr, cc = c + dc;
 if (rr < 0 || rr > 9 || cc < 0 || cc > 8) continue;
 int lr = r + (chAbs(dr) == 2 ? dr / 2 : 0), lc = c + (chAbs(dc) == 2 ? dc / 2 : 0);
 if (xqB[lr * 9 + lc]) continue;
 int q = xqB[rr * 9 + cc];
 if (q && (q > 0) == (s > 0)) continue;
 if (caps && !q) continue;
 xqAdd(o, n, sq, rr * 9 + cc);
 }
 } else if (t == XQ_S) {
 int dir = s > 0 ? -1 : 1, rr = r + dir;
 bool crossed = s > 0 ? r <= 4 : r >= 5;
 if (rr >= 0 && rr < 10) { int q = xqB[rr * 9 + c]; if (!(q && (q > 0) == (s > 0)) && !(caps && !q)) xqAdd(o, n, sq, rr * 9 + c); }
 if (crossed) for (int dc = -1; dc <= 1; dc += 2) {
 int cc = c + dc; if (cc < 0 || cc > 8) continue;
 int q = xqB[r * 9 + cc];
 if (q && (q > 0) == (s > 0)) continue;
 if (caps && !q) continue;
 xqAdd(o, n, sq, r * 9 + cc);
 }
 } else if (t == XQ_G || t == XQ_A) {
 for (int i = 0; i < 4; i++) {
 int rr = r + (t == XQ_G ? XQ_O[i][0] : XQ_D[i][0]), cc = c + (t == XQ_G ? XQ_O[i][1] : XQ_D[i][1]);
 if (!xqPal(rr, cc, s)) continue;
 int q = xqB[rr * 9 + cc];
 if (q && (q > 0) == (s > 0)) continue;
 if (caps && !q) continue;
 xqAdd(o, n, sq, rr * 9 + cc);
 }
 } else {
 for (int i = 0; i < 4; i++) {
 int rr = r + XQ_D[i][0] * 2, cc = c + XQ_D[i][1] * 2;
 if (rr < 0 || rr > 9 || cc < 0 || cc > 8) continue;
 if (s > 0 ? rr < 5 : rr > 4) continue;
 if (xqB[(r + XQ_D[i][0]) * 9 + c + XQ_D[i][1]]) continue;
 int q = xqB[rr * 9 + cc];
 if (q && (q > 0) == (s > 0)) continue;
 if (caps && !q) continue;
 xqAdd(o, n, sq, rr * 9 + cc);
 }
 }
 }
 return n;
}
static void xqMake(const XqMv &m, XqUn &u) {
 u.f = m.f; u.t = m.t; u.cap = xqB[m.t]; u.half = xqHalf;
 xqHalf = u.cap ? 0 : xqHalf + 1;
 xqB[m.t] = xqB[m.f]; xqB[m.f] = 0; xqSide = -xqSide;
}
static void xqUnmake(const XqUn &u) { xqSide = -xqSide; xqB[u.f] = xqB[u.t]; xqB[u.t] = u.cap; xqHalf = u.half; }
static bool xqInCheck(int s) { int k = xqKingSq(s); return k >= 0 && xqAtt(k, -s); }
static bool xqSafeAfter(int s) { int k = xqKingSq(s); return k >= 0 && !xqAtt(k, -s); }
static int xqLegal(XqMv *o) {
 XqMv tmp[128]; int n = xqGen(tmp, false), k = 0, s = xqSide;
 for (int i = 0; i < n; i++) { XqUn u; xqMake(tmp[i], u); bool ok = xqSafeAfter(s); xqUnmake(u); if (ok) o[k++] = tmp[i]; }
 return k;
}
static int xqEval() {
 int sc = 0;
 for (int sq = 0; sq < 90; sq++) {
 int p = xqB[sq]; if (!p) continue;
 int t = chAbs(p), r = sq / 9, c = sq % 9;
 int adv = p > 0 ? 9 - r : r;
 int cx = c < 4 ? c : 8 - c;
 int v = XQ_VAL[t];
 switch (t) {
 case XQ_S: if (adv >= 5) v += 60 + (adv - 5) * 12 + (cx >= 2 ? 0 : 15); break;
 case XQ_H: v += cx * 6 + (adv >= 3 ? 10 : 0) + (adv >= 5 ? 15 : 0); break;
 case XQ_R: v += (adv >= 4 ? 15 : 0) + (cx == 4 ? 6 : 0); break;
 case XQ_C: v += (cx == 4 ? 12 : 0) + (adv >= 2 ? 8 : 0); break;
 case XQ_A: case XQ_E: v += 4; break;
 default: break;
 }
 sc += p > 0 ? v : -v;
 }
 return xqSide > 0 ? sc : -sc;
}
static unsigned long xqDead = 0; static bool xqAbort = false; static uint32_t xqNodes = 0;
static inline bool xqTick() {
 if ((++xqNodes & 127) == 0) {
 esp_task_wdt_reset();
 if ((long)(millis() - xqDead) >= 0 || (xqNodes > 5000 && mgUserWantsOut())) xqAbort = true;
 }
 return xqAbort;
}
static void xqScore(XqMv *m, int n) {
 for (int i = 0; i < n; i++) {
 int cap = xqB[m[i].t];
 m[i].sc = cap ? XQ_VAL[chAbs(cap)] * 10 - XQ_VAL[chAbs(xqB[m[i].f])] / 10 + 100 : 0;
 }
}
static inline void xqPick(XqMv *m, int n, int i) {
 int b = i; for (int j = i + 1; j < n; j++) if (m[j].sc > m[b].sc) b = j;
 if (b != i) { XqMv t = m[i]; m[i] = m[b]; m[b] = t; }
}
static int xqQ(int alpha, int beta, int qd) {
 if (xqTick()) return 0;
 int stand = xqEval();
 if (stand >= beta) return stand;
 if (stand > alpha) alpha = stand;
 if (qd <= 0) return alpha;
 XqMv mv[64]; int n = xqGen(mv, true); if (n > 64) n = 64;
 xqScore(mv, n);
 int s = xqSide;
 for (int i = 0; i < n; i++) {
 xqPick(mv, n, i);
 XqUn u; xqMake(mv[i], u);
 if (!xqSafeAfter(s)) { xqUnmake(u); continue; }
 int v = -xqQ(-beta, -alpha, qd - 1);
 xqUnmake(u);
 if (xqAbort) return 0;
 if (v >= beta) return v;
 if (v > alpha) alpha = v;
 }
 return alpha;
}
static int xqNeg(int depth, int alpha, int beta, int ply) {
 if (xqTick()) return 0;
 if (xqHalf >= 120) return 0;
 int s = xqSide;
 bool inChk = xqInCheck(s);
 if (depth <= 0 && !inChk) return xqQ(alpha, beta, 4);
 if (depth <= -2) return xqEval();
 XqMv mv[128]; int n = xqGen(mv, false);
 xqScore(mv, n);
 int legal = 0;
 for (int i = 0; i < n; i++) {
 xqPick(mv, n, i);
 XqUn u; xqMake(mv[i], u);
 if (!xqSafeAfter(s)) { xqUnmake(u); continue; }
 legal++;
 int v = -xqNeg(depth - 1, -beta, -alpha, ply + 1);
 xqUnmake(u);
 if (xqAbort) return 0;
 if (v >= beta) return v;
 if (v > alpha) alpha = v;
 }
 if (!legal) return -30000 + ply;
 return alpha;
}
static bool xqBest(int level, XqMv &best) {
 XqMv mv[128]; int n = xqLegal(mv);
 if (!n) return false;
 if (n == 1) { best = mv[0]; return true; }
 int maxD = level == 0 ? 1 : (level == 1 ? 3 : 5);
 unsigned long ms = level == 0 ? 600 : (level == 1 ? 2500 : 5500);
 xqAbort = false; xqNodes = 0; xqDead = millis() + ms;
 xqScore(mv, n);
 for (int i = 0; i < n; i++) xqPick(mv, n, i);
 int sc[128]; for (int i = 0; i < n; i++) sc[i] = 0;
 int done = 0;
 int margin = level == 0 ? 160 : (level == 1 ? 12 : 0);
 for (int d = 1; d <= maxD; d++) {
 int bi = -1, bv = -32000;
 int tmp[128];
 for (int k = 0; k < n; k++) {
 int a = (bv == -32000) ? -32000 : bv - margin - 1;
 XqUn u; xqMake(mv[k], u);
 int v = (level == 0) ? -xqQ(-32000, -a, 0) : -xqNeg(d - 1, -32000, -a, 1);
 xqUnmake(u);
 if (xqAbort) break;
 tmp[k] = v;
 if (v > bv) { bv = v; bi = k; }
 }
 if (xqAbort) break;
 for (int k = 0; k < n; k++) sc[k] = tmp[k];
 done = d;
 XqMv t = mv[bi]; int ts = sc[bi];
 for (int k = bi; k > 0; k--) { mv[k] = mv[k - 1]; sc[k] = sc[k - 1]; }
 mv[0] = t; sc[0] = ts;
 if (bv > 29000) break;
 }
 if (!done) { best = mv[0]; return true; }
 int top = sc[0]; for (int k = 1; k < n; k++) if (sc[k] > top) top = sc[k];
 int cand[128], nc = 0;
 for (int k = 0; k < n; k++) if (sc[k] >= top - margin) cand[nc++] = k;
 best = mv[cand[nc > 1 ? (int)(random(nc)) : 0]];
 return true;
}
