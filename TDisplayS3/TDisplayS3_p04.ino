static void phMoveToDevice(int &idx) {
 if (idx < 0 || idx >= photoCount || photoIsInternal[idx]) { showMessage(tr("Already on device", "Ảnh đã có trong máy")); return; }
 String nm = photoList[idx];
 String key = phKey(idx);
 String dst = String(INTERNAL_PHOTO_DIR) + "/" + photoShortName(nm);
 if (lfsBegin() && lfsFileSize(dst.c_str()) > 0) { showMessage(tr("Already on device", "Ảnh đã có trong máy")); return; }
 copyPhotoToInternal(idx);
 if (!(lfsBegin() && lfsFileSize(dst.c_str()) > 0)) return;
 sd.remove((String(PHOTO_DIR) + "/" + nm).c_str());
 sd.remove((String(PH_THUMB_DIR) + "/" + key + ".t").c_str());
 sd.remove((String(PH_THUMB_DIR) + "/" + key + ".r").c_str());
 scanPhotos();
 if (!hasFullAccess() && photoCount > FREE_MAX_PHOTOS) photoCount = FREE_MAX_PHOTOS;
 if (idx >= photoCount) idx = photoCount - 1;
 if (idx < 0) idx = 0;
 showMessage(tr("Moved to device", "Đã di chuyển vào máy"));
}
void runPhotoViewer(int startIndex) {
 int idx = startIndex;
 bool needDraw = true;
 bool swiped = false;
 int W = gfx->width(), H = gfx->height();
 lastFrameAlloc(W, H);
 uint16_t *frame = (uint16_t *)allocBuffer((size_t)W * H * sizeof(uint16_t));
 gPhotoZoomWant = (frame != nullptr);
 bool zoomable = false, zoomed = false, redraw = false, pressed = false, panning = false, sheetFired = false;
 float cx = 0, cy = 0, k = 1, fitK = 1, zoomK = 1, panCx = 0, panCy = 0;
 int16_t x0 = 0, y0 = 0, x1 = 0, y1 = 0, lastTx = -100, lastTy = -100;
 unsigned long t0 = 0, lastTapMs = 0, lastRender = 0;
 while (true) {
  if (needDraw) {
   needDraw = false; zoomed = false; zoomable = false;
   if (gLastFrame) memset(gLastFrame, 0, (size_t)gLastFrameW * gLastFrameH * sizeof(uint16_t));
   showPhoto(idx);
   if (gPhotoZoomOk) {
    zoomable = true;
    fitK = min((float)W / fzW, (float)H / fzH);
    zoomK = max(fitK * 3.0f, 1.0f);
    k = fitK; cx = fzW / 2.0f; cy = fzH / 2.0f;
    redraw = true;
   }
  }
  if (redraw) {
   redraw = false;
   fzClamp(cx, cy, k);
   fzRender(frame, cx, cy, k);
   gfx->draw16bitRGBBitmap(0, 0, frame, W, H);
   lastFrameStore(0, 0, W, H, frame);
   lastRender = millis();
  }
  handleButtons(DOUBLE_WINDOW_MS);
  if (evt_boot_long) {
   evt_boot_long = false;
   if (confirmPowerOff()) powerOff(); else needDraw = true;
  }
  if (evt_boot_double) { evt_boot_double = false; break; }
  if (evt_pin14_single) { evt_pin14_single = false; idx = (idx + 1) % photoCount; needDraw = true; }
  if (evt_boot_single) { evt_boot_single = false; idx = (idx - 1 + photoCount) % photoCount; needDraw = true; }
  if (evt_pin14_double) {
   evt_pin14_double = false;
   copyPhotoToInternal(idx);
   needDraw = true;
  }
  if (evt_pin14_long) { evt_pin14_long = false; }
  if (touchSwipeUpExit(52, true)) { swiped = true; break; }
  int16_t nx, ny, sx, sy;
  bool down = touchReadDebounced(nx, ny);
  if (down) {
   touchToScreen(nx, ny, sx, sy);
   if (!pressed) { pressed = true; panning = false; x0 = sx; y0 = sy; t0 = millis(); panCx = cx; panCy = cy; }
   x1 = sx; y1 = sy;
   if (!panning && !sheetFired && millis() - t0 > 500 && abs(x1 - x0) < 16 && abs(y1 - y0) < 16 && y0 < H - 16) {
    sheetFired = true;
    bool outside = false;
    if (zoomable && !zoomed) {
     float dw = fzW * fitK, dh = fzH * fitK;
     outside = (x0 < (W - dw) / 2 - 2 || x0 > (W + dw) / 2 + 2 || y0 < (H - dh) / 2 - 2 || y0 > (H + dh) / 2 + 2);
    }
    int act = outside ? phOutsideSheet(idx) : phActionSheet(idx);
    bool refresh = true;
    if (act == 0) {
     if (zoomable && fzRotate(1)) {
      phRotSet(idx, (uint8_t)(phRotGet(idx) + 1));
      fitK = min((float)W / fzW, (float)H / fzH); zoomK = max(fitK * 3.0f, 1.0f);
      zoomed = false; k = fitK; cx = fzW / 2.0f; cy = fzH / 2.0f;
      refresh = false; redraw = true;
     } else showMessage(tr("Rotate: JPG only", "Chỉ xoay được ảnh JPG"));
    } else if (act == 1) {
     phShowInfo(idx, zoomable ? gFzJw : 0, zoomable ? gFzJh : 0);
    } else if (act == 2) {
     phWallpaperFlow(zoomable);
    } else if (act == 5) {
     phMoveToDevice(idx);
     if (photoCount == 0) { break; }
     refresh = false; needDraw = true; redraw = false;
    } else if (act == 3) {
     copyPhotoToInternal(idx);
    } else if (act == 4) {
     if (phDeleteAny(idx)) {
      if (photoCount == 0) { break; }
      if (idx >= photoCount) idx = photoCount - 1;
      refresh = false; needDraw = true; redraw = false;
     }
    }
    if (refresh) { if (zoomable) redraw = true; else needDraw = true; }
    continue;
   }
   if (zoomed && zoomable && y0 < H - GESTURE_ARM_ZONE_H && (abs(x1 - x0) > 6 || abs(y1 - y0) > 6)) {
    panning = true;
    if (millis() - lastRender > 25) { cx = panCx - (x1 - x0) / k; cy = panCy - (y1 - y0) / k; redraw = true; }
   }
  } else if (pressed) {
   pressed = false;
   if (sheetFired) { sheetFired = false; continue; }
   int dx = x1 - x0, dy = y1 - y0;
   if (panning) { cx = panCx - dx / k; cy = panCy - dy / k; redraw = true; }
   else if (y0 < H - GESTURE_ARM_ZONE_H) {
    if (!zoomed && abs(dx) > 40 && abs(dx) > abs(dy)) {
     idx = (dx < 0) ? (idx + 1) % photoCount : (idx - 1 + photoCount) % photoCount;
     needDraw = true;
    } else if (abs(dx) < 12 && abs(dy) < 12 && millis() - t0 < 500) {
     unsigned long now = millis();
     if (!zoomable) { idx = (idx + 1) % photoCount; needDraw = true; }
     else if (now - lastTapMs < 380 && abs(x0 - lastTx) < 40 && abs(y0 - lastTy) < 40) {
      lastTapMs = 0;
      if (!zoomed) {
       float bx = fzW / 2.0f + (x0 - W / 2.0f) / fitK, by = fzH / 2.0f + (y0 - H / 2.0f) / fitK;
       zoomed = true; k = zoomK; cx = bx; cy = by;
