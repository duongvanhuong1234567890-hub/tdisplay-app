bool drawJpegFromMemory(const uint8_t *data, uint32_t len) {
 if (!data || len == 0) return false;
 uint16_t jw = 0, jh = 0;
 TJpgDec.getJpgSize(&jw, &jh, data, len);
 if (jw == 0 || jh == 0) return false;
 uint8_t scale = 1;
 while (scale < 8 && (jw / scale > gfx->width() || jh / scale > gfx->height())) scale *= 2;
 TJpgDec.setJpgScale(scale);
 int16_t dispW = jw / scale, dispH = jh / scale;
 int16_t ox = (gfx->width() - dispW) / 2; if (ox < 0) ox = 0;
 int16_t oy = (gfx->height() - dispH) / 2; if (oy < 0) oy = 0;
 if (dispW < gfx->width() || dispH < gfx->height()) gfx->fillScreen(COLOR_BLACK);
 bool ok = TJpgDec.drawJpg(ox, oy, data, len);
 TJpgDec.setJpgScale(1);
 return ok;
}
bool bufferOutputCallback(int16_t x, int16_t y, uint16_t w, uint16_t h, uint16_t *bitmap) {
 if (!jpegBufferTarget) return true;
 int16_t W = gfx->width(), H = gfx->height();
 int16_t x1 = x + (int16_t)w, y1 = y + (int16_t)h;
 int16_t cx0 = max((int16_t)0, x), cy0 = max((int16_t)0, y);
 int16_t cx1 = min(W, x1), cy1 = min(H, y1);
 for (int16_t row = cy0; row < cy1; row++) {
 const uint16_t *src = bitmap + (size_t)(row - y) * w + (size_t)(cx0 - x);
 memcpy(jpegBufferTarget + (size_t)row * W + cx0, src, (size_t)(cx1 - cx0) * sizeof(uint16_t));
 }
 return true;
}
bool decodeJpegToBuffer(const uint8_t *data, uint32_t len, uint16_t *destBuf) {
 if (!data || len == 0 || !destBuf) return false;
 memset(destBuf, 0, (size_t)gfx->width() * gfx->height() * sizeof(uint16_t));
 uint16_t jw = 0, jh = 0;
 TJpgDec.getJpgSize(&jw, &jh, data, len);
 uint8_t scale = 1;
 while (scale < 8 && (jw / scale > gfx->width() || jh / scale > gfx->height())) scale *= 2;
 TJpgDec.setJpgScale(scale);
 int16_t dispW = jw / scale, dispH = jh / scale;
 int16_t ox = (gfx->width() - dispW) / 2; if (ox < 0) ox = 0;
 int16_t oy = (gfx->height() - dispH) / 2; if (oy < 0) oy = 0;
 jpegBufferTarget = destBuf;
 TJpgDec.setCallback(bufferOutputCallback);
 TJpgDec.drawJpg(ox, oy, data, len);
 TJpgDec.setCallback(tftOutputCallback);
 jpegBufferTarget = nullptr;
 TJpgDec.setJpgScale(1);
 return true;
}
