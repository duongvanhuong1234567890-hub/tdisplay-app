static String ytCleanField(String s) {
 s.replace('\t', ' ');
 s.replace('\n', ' ');
 s.replace('\r', ' ');
 s.trim();
 return s;
}
static String ytCapBytes(String s, int maxBytes) {
 if ((int)s.length() <= maxBytes) return s;
 int n = maxBytes;
 while (n > 0 && (((uint8_t)s[n]) & 0xC0) == 0x80) n--;
 return s.substring(0, n);
}
static void ytStoreLoad() {
 if (gYtStoreLoaded) return;
 gYtStoreLoaded = true;
 gYtHistN = 0;
 gYtRecN = 0;
 String h = prefs.getString("yth", "");
 int p = 0;
 while (p < (int)h.length() && gYtHistN < YTH_MAX) {
  int e = h.indexOf('\n', p);
  if (e < 0) e = (int)h.length();
  if (e > p) gYtHist[gYtHistN++] = h.substring(p, e);
  p = e + 1;
 }
 String r = prefs.getString("ytr", "");
 p = 0;
 while (p < (int)r.length() && gYtRecN < YTR_MAX) {
  int e = r.indexOf('\n', p);
  if (e < 0) e = (int)r.length();
  String line = r.substring(p, e);
  p = e + 1;
  int a = line.indexOf('\t');
  int b = (a < 0) ? -1 : line.indexOf('\t', a + 1);
  int c = (b < 0) ? -1 : line.indexOf('\t', b + 1);
  if (a <= 0 || b < 0 || c < 0) continue;
  YtListItem &it = gYtRec[gYtRecN++];
  it.id = line.substring(0, a);
  it.title = line.substring(a + 1, b);
  it.chan = line.substring(b + 1, c);
  it.dur = line.substring(c + 1);
 }
}
