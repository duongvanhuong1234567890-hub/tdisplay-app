 uint16_t g = CH_TINY[glyph];
 for (int py = 0; py < 5; py++) for (int px = 0; px < 3; px++)
 if (g & (1 << (14 - (py * 3 + px)))) gfx->drawPixel(cgx + CH_CELL - 1 - (vy + py), cgy + vx + px, col);
}
static void chDraw() {
 UiCanvasGuard _g;
 gfx->fillScreen(MG_BG);
