static void phGridReset() {
 gThDirty = false;
 for (int i = 0; i < MAX_PHOTOS; i++) { gThState[i] = 0; gPhRot[i] = 0xFF; }
 for (int s = 0; s < PH_RAM_SLOTS; s++) gThIdx[s] = -1;
 gThNext = 0;
}
static void phLayout() {
 int W = gfx->width();
 gThGap = 6;
 gThCols = max(2, W / 80);
 gThCell = (W - (gThCols + 1) * gThGap) / gThCols;
 gThRowH = gThCell + gThGap;
}
static String phKey(int i) { return String(photoIsInternal[i] ? "dev_" : "") + photoShortName(photoList[i]); }
static String phThPath(int i, const char *ext) { return String(PH_THUMB_DIR) + "/" + phKey(i) + ext; }
static uint8_t phRotGet(int i) {
 if (gThDirty) phGridReset();
 if (i < 0 || i >= MAX_PHOTOS) return 0;
 if (gPhRot[i] != 0xFF) return gPhRot[i];
 uint8_t r = 0;
 if (sdMounted) {
  FsFile f = sd.open(phThPath(i, ".r").c_str(), O_READ);
  if (f) { uint8_t b = 0; if (f.read(&b, 1) == 1 && b < 4) r = b; f.close(); }
 }
 gPhRot[i] = r;
 return r;
}
static void phThInvalidate(int i) {
 for (int s = 0; s < PH_RAM_SLOTS; s++) if (gThIdx[s] == i) gThIdx[s] = -1;
 if (i >= 0 && i < MAX_PHOTOS) gThState[i] = 0;
}
static void phRotSet(int i, uint8_t r) {
 if (gThDirty) phGridReset();
 r &= 3;
 gPhRot[i] = r;
 if (sdMounted) {
  if (!sd.exists(PH_THUMB_DIR)) sd.mkdir(PH_THUMB_DIR);
  String p = phThPath(i, ".r");
  if (r == 0) { sd.remove(p.c_str()); }
  else { FsFile f = sd.open(p.c_str(), O_WRITE | O_CREAT | O_TRUNC); if (f) { f.write(&r, 1); f.close(); } }
 }
 phThInvalidate(i);
}
static bool phThumbLoad(int idx, uint16_t *dst) {
 if (!sdMounted) return false;
 FsFile f = sd.open(phThPath(idx, ".t").c_str(), O_READ);
 if (!f) return false;
 uint8_t hd[8];
 bool ok = false;
 size_t bytes = (size_t)gThCell * gThCell * 2;
 if (f.read(hd, 8) == 8 && hd[0] == 'T' && hd[1] == 'H' && hd[2] == 'M' && hd[3] == '1' &&
     (int)(hd[4] | (hd[5] << 8)) == gThCell && hd[6] == phRotGet(idx)) {
  ok = ((size_t)f.read(dst, bytes) == bytes);
 }
 f.close();
 return ok;
}
static uint16_t *phSlotGet(int idx) {
 for (int s = 0; s < PH_RAM_SLOTS; s++) if (gThIdx[s] == idx && gThPx[s]) return gThPx[s];
 int s = gThNext; gThNext = (gThNext + 1) % PH_RAM_SLOTS;
 if (!gThPx[s]) gThPx[s] = (uint16_t *)allocBuffer((size_t)gThCell * gThCell * 2);
 if (!gThPx[s]) return nullptr;
 gThIdx[s] = -1;
 if (phThumbLoad(idx, gThPx[s])) { gThIdx[s] = idx; return gThPx[s]; }
 return nullptr;
}
static uint8_t *phReadFile(int idx, uint32_t &fsize, uint32_t cap) {
 uint8_t *buf = nullptr;
 fsize = 0;
 if (photoIsInternal[idx]) {
  String path = String(INTERNAL_PHOTO_DIR) + "/" + photoList[idx];
  fsize = lfsFileSize(path.c_str());
  if (fsize == 0 || fsize > cap) return nullptr;
  buf = allocBuffer(fsize);
  if (!buf) return nullptr;
  if (!lfsReadFileInto(path.c_str(), buf, fsize)) { free(buf); return nullptr; }
 } else {
  String path = String(PHOTO_DIR) + "/" + photoList[idx];
  FsFile f = sd.open(path.c_str(), O_READ);
  if (!f) return nullptr;
  fsize = f.fileSize();
  if (fsize == 0 || fsize > cap) { f.close(); return nullptr; }
  buf = allocBuffer(fsize);
  if (!buf) { f.close(); return nullptr; }
  int rd = f.read(buf, fsize);
  f.close();
  if (rd < 0 || (uint32_t)rd != fsize) { free(buf); return nullptr; }
 }
 return buf;
}
static bool thCb(int16_t x, int16_t y, uint16_t w, uint16_t h, uint16_t *bm) {
 if (!gThTmp) return false;
 for (int r = 0; r < h; r++) {
  int yy = y + r;
  if (yy < 0 || yy >= gThTh) continue;
  int x0 = x < 0 ? -x : 0;
  int x1 = (x + w > gThTw) ? (gThTw - x) : w;
  if (x1 <= x0) continue;
  memcpy(gThTmp + (size_t)yy * gThTw + x + x0, bm + (size_t)r * w + x0, (size_t)(x1 - x0) * sizeof(uint16_t));
 }
 return true;
}
static bool phIsJpegName(const String &n) {
 String l = n; l.toLowerCase();
 return l.endsWith(".jpg") || l.endsWith(".jpeg") || l.endsWith(".jpe") || l.endsWith(".jfif");
}
static bool phThumbMake(int idx) {
 if (!sdMounted || !phIsJpegName(photoList[idx])) return false;
 uint32_t fs = 0;
 uint8_t *buf = phReadFile(idx, fs, 6UL * 1024 * 1024);
 if (!buf) return false;
 bool ok = false;
 uint16_t jw = 0, jh = 0;
 if (fs > 3 && buf[0] == 0xFF && buf[1] == 0xD8 && TJpgDec.getJpgSize(&jw, &jh, buf, fs) == JDR_OK && jw > 0 && jh > 0) {
  const int dim = gThCell;
  int sc = 1;
  while (sc < 8 && (int)min((int)jw, (int)jh) / (sc * 2) >= dim) sc *= 2;
  gThTw = (jw + sc - 1) / sc; gThTh = (jh + sc - 1) / sc;
  gThTmp = (uint16_t *)allocBuffer((size_t)gThTw * gThTh * 2);
  if (gThTmp) {
   memset(gThTmp, 0, (size_t)gThTw * gThTh * 2);
   TJpgDec.setCallback(thCb);
   TJpgDec.setJpgScale(sc);
   JRESULT jr = TJpgDec.drawJpg(0, 0, buf, fs);
   TJpgDec.setJpgScale(1);
   TJpgDec.setCallback(tftOutputCallback);
   if (jr == JDR_OK) {
    uint16_t *out = (uint16_t *)allocBuffer((size_t)dim * dim * 2);
    if (out) {
     const int side = min(gThTw, gThTh);
     const int cx0 = (gThTw - side) / 2, cy0 = (gThTh - side) / 2;
     const uint8_t rot = phRotGet(idx);
     for (int oy = 0; oy < dim; oy++) {
      int v = (int)((int64_t)oy * side / dim);
      for (int ox = 0; ox < dim; ox++) {
       int u = (int)((int64_t)ox * side / dim);
       int qx, qy;
       switch (rot) {
        case 1: qx = v; qy = side - 1 - u; break;
        case 2: qx = side - 1 - u; qy = side - 1 - v; break;
        case 3: qx = side - 1 - v; qy = u; break;
        default: qx = u; qy = v; break;
       }
       out[(size_t)oy * dim + ox] = gThTmp[(size_t)(cy0 + qy) * gThTw + cx0 + qx];
      }
     }
     if (!sd.exists(PH_THUMB_DIR)) sd.mkdir(PH_THUMB_DIR);
     FsFile f = sd.open(phThPath(idx, ".t").c_str(), O_WRITE | O_CREAT | O_TRUNC);
     if (f) {
      uint8_t hd[8] = { 'T', 'H', 'M', '1', (uint8_t)(dim & 255), (uint8_t)(dim >> 8), rot, 0 };
      size_t bytes = (size_t)dim * dim * 2;
      ok = (f.write(hd, 8) == 8) && ((size_t)f.write((const uint8_t *)out, bytes) == bytes);
      f.close();
     }
     free(out);
    }
   }
   free(gThTmp); gThTmp = nullptr;
  }
 }
 free(buf);
 return ok;
}
static int phAreaBottom() { return gfx->height() - GESTURE_BAR_ZONE_H; }
static int phMaxScroll() {
 int rows = (photoCount + gThCols - 1) / gThCols;
 int content = rows * gThRowH + gThGap;
 int area = phAreaBottom() - gThTop0;
 return content > area ? content - area : 0;
}
static void phEnsureVisible() {
 if (photoCount == 0) { gThScroll = 0; return; }
 int row = photoIndex / gThCols;
 int top = row * gThRowH, bot = top + gThRowH + gThGap;
 int area = phAreaBottom() - gThTop0;
 if (top < gThScroll) gThScroll = top;
 if (bot > gThScroll + area) gThScroll = bot - area;
 int ms = phMaxScroll();
 if (gThScroll > ms) gThScroll = ms;
 if (gThScroll < 0) gThScroll = 0;
}
static void phFillClip(int x, int y, int w, int h, uint16_t c) {
 int t = gThTop0, b = phAreaBottom();
 if (y < t) { h -= (t - y); y = t; }
 if (y + h > b) h = b - y;
 if (h > 0 && w > 0) gfx->fillRect(x, y, w, h, c);
}
static void phDrawCell(int i, int x, int y) {
 const int cell = gThCell, t = gThTop0, b = phAreaBottom();
 if (y + cell <= t || y >= b) return;
 uint16_t *px = nullptr;
 if (gThState[i] == 0 || gThState[i] == 1) {
  px = phSlotGet(i);
  gThState[i] = px ? 1 : 2;
 }
 if (px) {
  for (int r = 0; r < cell; r++) {
   int yy = y + r;
   if (yy < t || yy >= b) continue;
   gfx->draw16bitRGBBitmap(x, yy, px + (size_t)r * cell, cell, 1);
  }
 } else {
  phFillClip(x, y, cell, cell, IOS_GRAY);
  if (y >= t && y + cell <= b) {
   String n = photoList[i];
   int dot = n.lastIndexOf('.');
   String lb = (gThState[i] == 3 && dot >= 0) ? n.substring(dot + 1) : String("...");
   lb.toUpperCase();
   if (lb.length() > 5) lb = lb.substring(0, 5);
   gfxSetTextColor(COLOR_WHITE, IOS_GRAY);
   gfxDrawAligned(lb, x + cell / 2, y + cell / 2, DATUM_MC);
  }
 }
 if (i == photoIndex) {
  for (int k = 0; k < 2; k++) {
   phFillClip(x - 1 - k, y - 1 - k, cell + 2 + 2 * k, 1, colorAccent);
   phFillClip(x - 1 - k, y + cell + k, cell + 2 + 2 * k, 1, colorAccent);
   phFillClip(x - 1 - k, y - 1 - k, 1, cell + 2 + 2 * k, colorAccent);
   phFillClip(x + cell + k, y - 1 - k, 1, cell + 2 + 2 * k, colorAccent);
  }
 }
}
static void phGridPaint() {
 int firstRow = max(0, (gThScroll - gThGap) / gThRowH);
 int lastRow = (gThScroll + phAreaBottom() - gThTop0) / gThRowH + 1;
 for (int row = firstRow; row <= lastRow; row++) {
  for (int c = 0; c < gThCols; c++) {
   int i = row * gThCols + c;
   if (i >= photoCount) break;
   phDrawCell(i, gThGap + c * (gThCell + gThGap), gThTop0 + gThGap + row * gThRowH - gThScroll);
  }
 }
}
