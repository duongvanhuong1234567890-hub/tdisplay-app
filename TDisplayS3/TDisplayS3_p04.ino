void loopPhotoMenu() {
 static bool pressed = false, drag = false;
 static int16_t x0 = 0, y0 = 0, x1 = 0, y1 = 0;
 static int scroll0 = 0;
 static unsigned long t0 = 0, lastPaint = 0;
 if (gThDirty) { phGridReset(); }
 phLayout();
 bool redraw = false;
 int16_t nx, ny, sx, sy;
 bool down = touchReadDebounced(nx, ny);
 if (down) {
  touchToScreen(nx, ny, sx, sy);
  if (!pressed) { pressed = true; drag = false; x0 = sx; y0 = sy; t0 = millis(); scroll0 = gThScroll; }
  x1 = sx; y1 = sy;
  if (y0 < phAreaBottom() && (drag || abs(y1 - y0) > 8)) {
   drag = true;
   int ns = scroll0 - (y1 - y0);
   int ms = phMaxScroll();
   if (ns < 0) ns = 0;
   if (ns > ms) ns = ms;
   if (ns != gThScroll && millis() - lastPaint > 30) { gThScroll = ns; lastPaint = millis(); phGridRedrawArea(); }
  }
 } else if (pressed) {
  pressed = false;
  if (!drag && y0 < phAreaBottom() && abs(x1 - x0) < 12 && abs(y1 - y0) < 12 && millis() - t0 < 700) {
   int hit = phHit(x0, y0);
   if (hit >= 0) {
    photoIndex = hit;
    if (gmPickingPhoto) {
     gmPickingPhoto = false; appState = STATE_GEMINI; gmSetAttachFromPhoto(photoIndex); drawGeminiPrompt(); return;
    }
    runPhotoViewer(photoIndex);
    lastActivity = millis();
    drawPhotoMenu();
    return;
   }
  }
 }
 if (evt_pin14_single) { evt_pin14_single = false; if (photoCount > 0) { photoIndex = (photoIndex + 1) % photoCount; redraw = true; } }
 if (evt_boot_single) { evt_boot_single = false; if (photoCount > 0) { photoIndex = (photoIndex - 1 + photoCount) % photoCount; redraw = true; } }
 if (evt_pin14_double) {
  evt_pin14_double = false;
  if (photoCount > 0) {
   if (gmPickingPhoto) { gmPickingPhoto = false; appState = STATE_GEMINI; gmSetAttachFromPhoto(photoIndex); drawGeminiPrompt(); return; }
   runPhotoViewer(photoIndex);
   lastActivity = millis();
   drawPhotoMenu();
   return;
  }
 }
 if (evt_boot_double) {
  evt_boot_double = false;
  if (gmPickingPhoto) { gmPickingPhoto = false; appState = STATE_GEMINI; drawGeminiPrompt(); return; }
  int zx, zy, zw, zh;
  menuGridCell(0, menuFixedRows(), zx, zy, zw, zh);
  menuIndex = 0; menuTop = 0;
  appState = STATE_MENU;
  closeScreenWithZoom(zx, zy, zw, zh, drawPhotoMenu, drawMenu);
  return;
 }
 if (redraw) { phEnsureVisible(); phGridRedrawArea(); }
 if (!pressed && !redraw && phGenTick()) phGridRedrawArea();
 updateClockAndWeather();
}
String fitFileName(const String &name, int maxW) {
 int16_t x1, y1; uint16_t w, h;
 gfx->getTextBounds(name.c_str(), 0, 0, &x1, &y1, &w, &h);
 if ((int)w <= maxW) return name;
 int dot = name.lastIndexOf('.');
 String ext = (dot > 0) ? name.substring(dot) : String("");
 String stem = (dot > 0) ? name.substring(0, dot) : name;
 gfx->getTextBounds(ext.c_str(), 0, 0, &x1, &y1, &w, &h);
 return truncateToWidth(stem, maxW - (int)w) + ext;
}
static bool gVidCompact = false;
#define VID_ROW_H (gVidCompact ? 30 : 44)
#define VT_N 12
#define VT_MAXW 56
#define VT_MAXH 40
static bool gVidShuffle = false;
static bool vcIdleBuild();
static uint32_t vcHash(const String &n) { uint32_t h = 2166136261u; for (size_t i = 0; i < n.length(); i++) { h ^= (uint8_t)n[i]; h *= 16777619u; } return h; }
static String vcPath(const String &name, const char *ext) { char b[24]; snprintf(b, sizeof(b), "/.cache/%08x.%s", (unsigned)vcHash(name), ext); return String(VIDEO_DIR) + b; }
static bool vcReadPos(const String &name, VcPos &p) { FsFile f = sd.open(vcPath(name, "pos").c_str(), O_READ); if (!f) return false; bool ok = f.read(&p, sizeof(p)) == (int)sizeof(p); f.close(); return ok; }
static VtEnt gVt[VT_N];
static uint8_t gVtNext = 0;
static uint16_t *gVtDst; static int gVtW, gVtH;
static bool vtCb(int16_t x, int16_t y, uint16_t w, uint16_t h, uint16_t *bmp) {
 for (int r = 0; r < h; r++) { int yy = y + r; if (yy < 0 || yy >= gVtH) continue;
  for (int c = 0; c < w; c++) { int xx = x + c; if (xx < 0 || xx >= gVtW) continue; gVtDst[yy * gVtW + xx] = bmp[r * w + c]; } }
 return true;
}
static void vcInvalidate(const String &name) { for (int i = 0; i < VT_N; i++) if (gVt[i].used && gVt[i].name == name) gVt[i].used = false; }
static VtEnt *vtGet(const String &name) {
 for (int i = 0; i < VT_N; i++) if (gVt[i].used && gVt[i].name == name) return &gVt[i];
 VtEnt &e = gVt[gVtNext]; gVtNext = (gVtNext + 1) % VT_N;
 e.used = true; e.name = name; e.w = e.h = 0; e.hasPos = vcReadPos(name, e.pos);
 {
  FsFile tf = sd.open(vcPath(name, "th").c_str(), O_READ);
  if (tf) {
   uint32_t hd[2];
   if (tf.read(hd, 8) == 8 && hd[0] == 0x31485448UL) {
    int tw = (int)(hd[1] & 0xFFFF), thh = (int)(hd[1] >> 16);
    if (tw > 0 && thh > 0 && tw <= VT_MAXW && thh <= VT_MAXH) {
     if (!e.px) e.px = (uint16_t *)allocBuffer(VT_MAXW * VT_MAXH * 2);
     if (e.px && tf.read(e.px, (size_t)tw * thh * 2) == (int)((size_t)tw * thh * 2)) { e.w = tw; e.h = thh; }
    }
   }
   tf.close();
   if (e.w) return &e;
  }
 }
 FsFile f = sd.open(vcPath(name, "jpg").c_str(), O_READ);
 if (f) {
  uint32_t n = f.fileSize();
  if (n > 8 && n <= 65536) {
   uint8_t *b = allocBuffer(n);
   if (b) {
    if (f.read(b, n) == (int)n) {
     uint16_t jw = 0, jh = 0; TJpgDec.getJpgSize(&jw, &jh, b, n);
     uint8_t sc = 1; while (sc < 8 && (jw / sc > VT_MAXW || jh / sc > VT_MAXH)) sc *= 2;
     int tw = (jw + sc - 1) / sc, th = (jh + sc - 1) / sc;
     if (jw && jh && tw <= VT_MAXW && th <= VT_MAXH) {
      if (!e.px) e.px = (uint16_t *)allocBuffer(VT_MAXW * VT_MAXH * 2);
      if (e.px) {
       gVtDst = e.px; gVtW = tw; gVtH = th;
       TJpgDec.setJpgScale(sc); TJpgDec.setCallback(vtCb);
       TJpgDec.drawJpg(0, 0, b, n);
       TJpgDec.setCallback(tftOutputCallback); TJpgDec.setJpgScale(1);
       e.w = tw; e.h = th;
      }
     }
    }
    free(b);
   }
  }
  f.close();
 }
 return &e;
}
static void vcThumbDraw(const String &name, int x, int y, int bw, int bh, uint16_t bg) {
 VtEnt *e = vtGet(name);
 if (e->w && e->px) {
  gfx->fillRect(x, y, bw, bh, COLOR_BLACK);
  if (e->w <= bw && e->h <= bh) {
   gfx->draw16bitRGBBitmap(x + (bw - e->w) / 2, y + (bh - e->h) / 2, e->px, e->w, e->h);
  } else {
   static uint16_t sc[VT_MAXW * VT_MAXH];
   int dw = bw, dh = e->h * bw / e->w;
   if (dh > bh) { dh = bh; dw = e->w * bh / e->h; }
   if (dw < 1) dw = 1;
   if (dh < 1) dh = 1;
   if (dw * dh <= VT_MAXW * VT_MAXH) {
    for (int j = 0; j < dh; j++) { int sy = j * e->h / dh; for (int i2 = 0; i2 < dw; i2++) sc[j * dw + i2] = e->px[sy * e->w + i2 * e->w / dw]; }
    gfx->draw16bitRGBBitmap(x + (bw - dw) / 2, y + (bh - dh) / 2, sc, dw, dh);
   }
  }
 } else {
  fillRoundRectAA(x, y, bw, bh, 5, 0x2104, bg);
  gfx->fillTriangle(x + bw / 2 - 5, y + bh / 2 - 7, x + bw / 2 - 5, y + bh / 2 + 7, x + bw / 2 + 7, y + bh / 2, COLOR_GRAY);
 }
}
