 chUnmake(chHist[--chHn]);
 if (chMode < 3 && chSide < 0 && chHn) chUnmake(chHist[--chHn]);
 chRefresh(); chPend = false;
}
static void chLoop(bool key) {
 (void)key;
 if (chPend && (long)(millis() - chAiAt) >= 0) {
 mgThinking = true; chDraw();
 ChMv m; bool ok = chBest(chMode, m);
 mgThinking = false;
 if (ok) chPlay(m);
 chRefresh(); chDraw(); return;
 }
 if (!mgT.pressed) return;
 int x = mgT.sx, y = mgT.sy;
 int b = cxHit(x, y, CH_PX, CH_PW);
