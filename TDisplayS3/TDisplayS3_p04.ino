 int lf = chHn ? chHist[chHn - 1].f : -1, lt = chHn ? chHist[chHn - 1].t : -1;
 int ks = chChk ? chKingSq(chSide) : -1;
 uint16_t cc[64];
 for (int sq = 0; sq < 64; sq++) {
 int r = sq >> 3, c = sq & 7;
