 int drawY = max(y, listTop);
 int drawBottom = min(rowBottom, listBottom);
 if (drawBottom <= drawY) continue;
 bool selected = (i == videoIndex);
 glFillBg(0, drawY, gfx->width(), drawBottom - drawY);
 if (y >= listTop && rowBottom <= listBottom) {
 if (selected) {
 fillRoundRectAA(2, y + 1, gfx->width() - 4, rowH - 2, 8, iosSelTint(), colorBG);
 gfxSetTextColor(colorFG, iosSelTint());
 } else {
 gfxSetTextColor(colorFG, colorBG);
 }
 drawVideoRowBody(i, y, rowH);
 if (selected) drawFocusRing(2, y + 1, gfx->width() - 4, rowH - 2, 8, 0);
 }
 }
 gfx->endWrite();
}
void updateVideoSelection() {
